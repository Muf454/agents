#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
# This repository validates the toolkit; installed copies validate target projects.
if [[ ! -d .ai && -d "$AI_BIN/../tests" ]]; then
  cd -- "$AI_BIN/.."
  while IFS= read -r -d '' file; do bash -n "$file"; done < <(
    find scripts -type f \( -name 'ai-*' -o -name setup-project -o -name '*.sh' \) -print0
  )
  for file in templates/.ai/validate templates/.ai/ci-setup; do bash -n "$file"; done
  python3 -m unittest discover -s tests -v
  exit
fi
ai_root
[[ -f .ai/validate ]] || ai_die 'Missing .ai/validate.'
wait=${AI_CHECK_LOCK_WAIT:-0}
[[ $wait =~ ^[0-9]{1,5}$ ]] || ai_die "Invalid AI_CHECK_LOCK_WAIT: $wait"
limit=${AI_CHECK_TIMEOUT:-1800}
[[ $limit =~ ^[0-9]{1,9}$ ]] || ai_die "Invalid AI_CHECK_TIMEOUT: $limit"
wait=$((10#$wait)) limit=$((10#$limit))
# One deadline: seconds spent waiting for the lock come out of the validator's budget.
started=$SECONDS
# The stamp changes only under the lock: a waiter that gives up leaves the running gate's record.
out_of_time() {
  echo 'Error: Validation time limit reached while waiting for the lock.' >&2
  exit 124
}
exec 8>.ai/local/validation.lock
if ! flock -n 8; then
  (( wait > 0 )) || ai_die 'Validation is already running.'
  echo "Waiting up to ${wait}s for a running validation to finish." >&2
  if (( limit <= wait )); then
    flock -w "$limit" 8 || out_of_time
  else
    flock -w "$wait" 8 || ai_die 'Validation is already running.'
  fi
fi
budget=$(( limit - (SECONDS - started) ))
# GNU timeout treats 0 as no deadline, so never start the validator without time left.
if (( budget <= 0 )); then
  ai_helper stamp invalidate
  out_of_time
fi
log=$(mktemp .ai/local/check-XXXXXXXX.log)
# Remove old evidence first: a failed/interrupted run cannot retain a green stamp.
ai_helper stamp invalidate
# The logger runs on its own descriptor so the validator is the recorded child: an INT/TERM
# (TERM alone when this gate is itself a background child) ends it at once. The stamp stays
# invalidated; only a finished run records a result.
tee_pid=''
stop_gate() {
  local tries=0
  ai_stop_child || true
  exec 7>&-
  if [[ -n "$tee_pid" ]]; then
    while kill -0 "$tee_pid" 2>/dev/null && (( tries++ < 50 )); do sleep 0.1; done
    kill -TERM "$tee_pid" 2>/dev/null || true
  fi
}
trap 'stop_gate; exit 130' INT
trap 'stop_gate; exit 143' TERM
exec 7> >(tee "$log")
tee_pid=$!
set +e
ai_run_child timeout --signal=TERM --kill-after=10s "$budget" bash .ai/validate >&7 2>&1
result=$?
exec 7>&-
wait "$tee_pid"
logged=$?
set -e
# A failed logger fails the gate even when the validator passed.
if (( logged != 0 )); then result=$logged; fi
ai_helper stamp record "$result" "$log"
exit "$result"
