#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
usage() {
  cat <<'EOF'
Usage: ai-pipeline --approved [--base REF] [--pr-base BRANCH] [--max-fix-rounds N]
                   [--draft] [--no-pr] [--review-timeout SECONDS] [--skip-plan-review]
                   [ai-run options: --sessions N --session-timeout S --run-timeout S
                    --model NAME --knowledge-dir DIR]
Hands-off delivery of an approved plan on a feature branch:
  Codex plan review (before any task starts; BLOCKER/MAJOR stops) -> implement (ai-run) -> full gate -> independent Codex review (ai-review)
  -> Claude triage + fix tasks (at most N rounds, default 2) -> review again
  -> push the feature branch and open/update a pull request -> notify.
--base is the review base (default main); --pr-base is the PR target branch
(default: --base when it is a local or origin/ branch).
The human tests and merges the PR. Nothing is merged or deployed. Rerun to resume.
Usage limits pause and resume (see ai-run). Notifications use AI_NOTIFY_CMD.
EOF
}
orig_args=("$@")
base=main; pr_base=''; max_fix_rounds=2; draft=no; open_pr=yes; approved=no; plan_review=yes
review_args=(); run_args=()
while (( $# )); do
  case "$1" in
    --approved) approved=yes; shift ;;
    --draft) draft=yes; shift ;;
    --no-pr) open_pr=no; shift ;;
    --skip-plan-review) plan_review=no; shift ;;
    --base)
      (( $# >= 2 )) && [[ "$2" != -* ]] || ai_die 'Missing base REF'
      base=$2; shift 2 ;;
    --pr-base)
      (( $# >= 2 )) && [[ "$2" =~ ^[A-Za-z0-9._/-]+$ ]] || ai_die 'Missing or invalid PR base branch'
      pr_base=$2; shift 2 ;;
    --max-fix-rounds)
      (( $# >= 2 )) && [[ "$2" =~ ^[0-5]$ ]] || ai_die '--max-fix-rounds must be 0-5'
      max_fix_rounds=$2; shift 2 ;;
    --review-timeout)
      (( $# >= 2 )) || ai_die 'Missing review timeout'
      review_args=(--timeout "$2"); shift 2 ;;
    --sessions|--session-timeout|--run-timeout|--model|--knowledge-dir)
      (( $# >= 2 )) || ai_die "Missing value for $1"
      run_args+=("$1" "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; ai_die "Unknown argument: $1" ;;
  esac
done
[[ "$approved" == yes ]] || ai_die 'Review the plan/permissions/checks, then pass --approved.'
command -v claude >/dev/null || ai_die 'Install and authenticate Claude Code first.'
command -v codex >/dev/null || ai_die 'Install and authenticate Codex CLI first.'
ai_root
# The pipeline owns the shared checkout lock for its whole run; its children inherit it.
ai_lock
export AI_LOCK_HELD=$$
rm -f .ai/local/last-error
# Liveness marker for ai-watchdog: removed by ai_die and finish, so one left behind
# with no runner alive means the pipeline was killed or the machine restarted.
AI_PIPELINE_MARKER=.ai/local/pipeline.active
printf '%s\n' "$$" > "$AI_PIPELINE_MARKER"
finish() {
  ai_helper run-manifest clear-attempts 2>/dev/null || true
  ai_drop_marker
  exit 0
}
AI_START_BRANCH=$(git symbolic-ref --quiet --short HEAD) || ai_die 'Detached HEAD; use a feature branch.'
ai_branch
base_sha=$(git rev-parse --verify --quiet "${base}^{commit}") || ai_die "Invalid base: $base"
if [[ "$open_pr" == yes && -z "$pr_base" ]]; then
  # The PR must target the branch the review compared against; never guess.
  if git show-ref --verify --quiet "refs/heads/$base"; then pr_base=$base
  elif [[ "$base" == origin/* ]] && git show-ref --verify --quiet "refs/remotes/$base"; then pr_base=${base#origin/}
  else ai_die "Cannot infer the PR target from --base $base; pass --pr-base BRANCH."
  fi
fi
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
  ai_die 'Start from a clean checkpoint. Reconcile/commit interrupted changes first.'
# The pipeline holds its own baseline of the gate across all steps.
AI_APPROVED_GATE=$(ai_guard_digest) || ai_die 'Cannot approve missing/unsafe workflow gate.'
readonly AI_APPROVED_GATE
if [[ -n "${AI_RECOVERY_ATTEMPT:-}" ]]; then
  # A resume must run under the gate and branch the human approved (host-side manifest).
  [[ "$AI_APPROVED_GATE" == "$(ai_helper run-manifest gate 2>/dev/null)" ]] || \
    ai_die 'Gate files changed since the run was approved; rerun ai-pipeline --approved yourself.'
  [[ "$AI_START_BRANCH" == "$(ai_helper run-manifest branch 2>/dev/null)" ]] || \
    ai_die 'Resumed on a different branch than the approved run.'
else
  # A human (re)start: record the approved run and give it a fresh recovery budget.
  ai_helper run-manifest start "$AI_APPROVED_GATE" "$AI_START_BRANCH" "${orig_args[@]}" || \
    ai_die 'Cannot record the run manifest in the host state directory.'
fi
export AI_PIPELINE=1
branch=$AI_START_BRANCH

stop() {
  local stage=$1 reason
  reason=$(cat .ai/local/last-error 2>/dev/null || true)
  reason=${reason:-see terminal}
  # Only hand over to checkout code that is still exactly the approved gate.
  if [[ "${AI_AUTO_RECOVER:-1}" != 0 && -x "$AI_BIN/ai-recover" && \
        "$(ai_guard_digest 2>/dev/null)" == "$AI_APPROVED_GATE" ]]; then
    # Bounded auto-recovery takes over this process (same PID, lock and marker).
    [[ -s .ai/local/last-error ]] || printf '%s\n' "stopped during $stage (see terminal)" > .ai/local/last-error
    exec "$AI_BIN/ai-recover" --stage "$stage"
  fi
  AI_STOP_NOTIFIED=1
  ai_notify "⛔ STOPPED, needs you: $branch stopped during $stage: ${reason%.}. Fix it, then rerun ai-pipeline."
  ai_die "Pipeline stopped during $stage: ${reason:-see output above}"
}
# Pushes hit transient network/auth hiccups; retry before treating it as a stop.
push() {
  local try
  for try in 1 2 3; do
    git push "$@" && return 0
    (( try == 3 )) || ${AI_SLEEP:-sleep} $(( try * 20 ))
  done
  return 1
}
step() { printf '\n== %s ==\n' "$*"; }
count_commits() { git log --oneline "$base_sha..HEAD" --grep="$1" | wc -l; }
# Commit host records, then re-verify before any project-local helper runs again
# (commit hooks could otherwise swap gate code in between).
host_commit() {
  git add -- "${@:2}"
  git commit -m "$1" >/dev/null
  ai_guard_verify
}
# Review is current if nothing but workflow records changed since the reviewed commit.
review_current() {
  local info reviewed
  info=$(ai_helper review-info 2>/dev/null) || return 1
  reviewed=${info%% *}
  git merge-base --is-ancestor "$base_sha" "$reviewed" 2>/dev/null || return 1
  git diff --quiet "$reviewed" HEAD -- . ':!.ai/reviews' ':!.ai/state.md' ':!.ai/run-log.md' ':!.ai/handoff.md'
}
ensure_validated() {
  if ! ai_helper stamp verify >/dev/null 2>&1; then
    step 'Validation'
    "$AI_BIN/ai-check" || stop validation
    ai_guard_verify
  fi
}

if [[ -n "${AI_RECOVERY_ATTEMPT:-}" ]]; then
  ai_notify "▶ RESUMED on $branch after auto-recovery ($AI_RECOVERY_ATTEMPT)."
else
  ai_notify "▶ STARTED on $branch."
fi
# Plan review: cheapest place to catch gaps, before any Claude usage is spent.
if [[ "$plan_review" == yes ]] && ai_helper tasks untouched 2>/dev/null; then
  if ! plan_info=$(ai_helper plan-review-info 2>/dev/null) || [[ "$plan_info" != current* ]]; then
    step 'Plan review (Codex)'
    "$AI_BIN/ai-review" --plan "${review_args[@]}" || stop 'plan review'
    ai_guard_verify
    host_commit 'chore(ai): record plan review' .ai/reviews/plan.md
    plan_info=$(ai_helper plan-review-info) || stop 'plan review'
    # A commit hook that changed reviewed content would make the verdict stale.
    [[ "$plan_info" == current* ]] || \
      { printf '%s\n' 'reviewed content changed while recording the plan review (commit hook?)' > .ai/local/last-error; stop 'plan review'; }
  fi
  read -r _ plan_blockers plan_majors _ <<< "$plan_info"
  if (( plan_blockers + plan_majors > 0 )); then
    printf '%s\n' "plan review found BLOCKER $plan_blockers, MAJOR $plan_majors; revise the plan (see .ai/reviews/plan.md) or rerun with --skip-plan-review" > .ai/local/last-error
    stop 'plan review'
  fi
fi
while true; do
  # Derived from the current review each round, so an earlier deferral doesn't stick.
  unresolved=0
  ai_guard_verify
  if ! ai_helper tasks complete 2>/dev/null; then
    step 'Implementation (Claude)'
    "$AI_BIN/ai-run" --approved "${run_args[@]}" || stop implementation
    ai_guard_verify
  fi
  if ! review_current; then
    ensure_validated
    step 'Independent review (Codex)'
    "$AI_BIN/ai-review" --base "$base" "${review_args[@]}" || stop review
    ai_guard_verify
    host_commit 'chore(ai): record independent review' .ai/reviews/current.md
  fi
  read -r _ blockers majors minors < <(ai_helper review-info)
  printf 'Review: BLOCKER %s, MAJOR %s, MINOR %s\n' "$blockers" "$majors" "$minors"
  (( blockers + majors > 0 )) || break
  # Dispositions for this exact review already complete (e.g. a rerun after triage)?
  if verdict=$(ai_helper triage-check 2>/dev/null) && ai_helper tasks complete 2>/dev/null; then
    read -r accepted deferred <<< "${verdict//[a-z=]/ }"
    # Accepted fixes always need a new review; if the review is still current, the
    # "fixes" changed nothing reviewable: hand it to the human as a draft.
    if (( accepted > 0 || deferred > 0 )); then unresolved=1; fi
    printf 'Findings already triaged (%s) and the review is still current.\n' "$verdict"
    break
  fi
  fixes=$(count_commits '^chore(ai): record review triage')
  if (( fixes >= max_fix_rounds )); then
    unresolved=1
    printf 'Fix round limit (%s) reached with significant findings; the PR will be a draft.\n' "$max_fix_rounds"
    break
  fi
  step "Review triage, round $(( fixes + 1 )) (Claude)"
  triage_args=()
  for (( i=0; i<${#run_args[@]}; i+=2 )); do
    case "${run_args[i]}" in --model|--knowledge-dir|--session-timeout) triage_args+=("${run_args[i]}" "${run_args[i+1]}") ;; esac
  done
  "$AI_BIN/ai-run" --approved --triage "${triage_args[@]}" || stop triage
  ai_guard_verify
  verdict=$(ai_helper triage-check --fresh) || stop triage
  read -r accepted deferred <<< "${verdict//[a-z=]/ }"
  if (( accepted == 0 )); then
    # Every significant finding was rejected (with evidence) or deferred.
    if (( deferred > 0 )); then unresolved=1; fi
    printf 'Triage added no fix tasks (%s); dispositions are recorded.\n' "$verdict"
    break
  fi
done

ai_guard_verify
ensure_validated
reviews=$(count_commits '^chore(ai): record independent review')
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || stop 'pull request preparation'
if [[ "$open_pr" != yes ]]; then
  ai_notify "🏁 FINISHED on $branch: all tasks done, validated and reviewed ($reviews review round(s)); no PR requested. Your todo: review the branch locally."
  printf '%s\n' 'Pipeline complete (no PR requested).'
  finish
fi
step 'Pull request'
if ! git remote get-url origin >/dev/null 2>&1; then
  ai_notify "🏁 FINISHED on $branch (local only): no 'origin' remote to open a PR on. Your todo: push and open a PR."
  printf '%s\n' "No 'origin' remote; branch is ready locally."
  finish
fi
push -u origin "$branch" || { printf '%s\n' 'git push failed (3 tries)' > .ai/local/last-error; stop push; }
ai_guard_verify  # push hooks run project code too
ai_helper review-info >/dev/null || stop 'pull request (review integrity)'
if ! command -v gh >/dev/null; then
  ai_notify "🏁 FINISHED on $branch: pushed, but gh is not installed. Your todo: open the PR yourself."
  finish
fi
title=$(ai_helper pr-title)
body=$(mktemp .ai/local/pr-XXXXXXXX.md)
ai_helper pr-body "$reviews" "$unresolved" > "$body"
make_draft=no
if [[ "$draft" == yes || "$unresolved" == 1 ]]; then make_draft=yes; fi
if url=$(gh pr view "$branch" --json url --jq .url 2>/dev/null) && [[ -n "$url" ]]; then
  gh pr edit "$branch" --body-file "$body" >/dev/null || { printf '%s\n' 'gh pr edit failed' > .ai/local/last-error; stop 'pull request'; }
  if [[ "$make_draft" == yes && "$(gh pr view "$branch" --json isDraft --jq .isDraft 2>/dev/null)" != true ]]; then
    # Never leave an existing ready PR "ready" when the policy says draft.
    gh pr ready --undo "$branch" >/dev/null 2>&1 && \
      [[ "$(gh pr view "$branch" --json isDraft --jq .isDraft 2>/dev/null)" == true ]] || \
      { printf '%s\n' 'could not convert the existing PR to draft' > .ai/local/last-error; stop 'pull request'; }
  fi
else
  pr_args=(--title "$title" --body-file "$body" --base "$pr_base")
  if [[ "$make_draft" == yes ]]; then pr_args+=(--draft); fi
  url=$(gh pr create --head "$branch" "${pr_args[@]}" | tail -n 1) || { printf '%s\n' 'gh pr create failed' > .ai/local/last-error; stop 'pull request'; }
fi
ai_helper state ready_for_acceptance "Human: test and merge the pull request $url"
ai_log none "pull request ready: $url" PASS 'Human acceptance and merge remain'
host_commit 'chore(ai): record pull request' .ai/state.md .ai/run-log.md
if ! push origin "$branch" >/dev/null 2>&1 || ! ai_guard_verify; then
  printf '%s\n' "PR is open at $url, but pushing the final handoff commit failed" > .ai/local/last-error
  stop 'final push'
fi
ai_notify "$(ai_helper finish-summary "$url" "$reviews" "$unresolved" 2>/dev/null || printf '🏁 FINISHED: PR %s' "$url")"
printf 'Pull request: %s\n' "$url"
finish
