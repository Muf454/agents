#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
usage() {
  cat <<'EOF'
Usage: ai-pipeline --approved [--base REF] [--max-fix-rounds N] [--draft] [--no-pr]
                   [--review-timeout SECONDS] [ai-run options: --sessions N
                   --session-timeout S --run-timeout S --model NAME --knowledge-dir DIR]
Hands-off delivery of an approved plan on a feature branch:
  implement (ai-run) -> full gate -> independent Codex review (ai-review)
  -> Claude triage + fix tasks (at most N rounds, default 2) -> review again
  -> push the feature branch and open/update a pull request -> notify.
The human tests and merges the PR. Nothing is merged or deployed. Rerun to resume.
Usage limits pause and resume (see ai-run). Notifications use AI_NOTIFY_CMD.
EOF
}
base=main; max_fix_rounds=2; draft=no; open_pr=yes; approved=no; review_args=(); run_args=()
while (( $# )); do
  case "$1" in
    --approved) approved=yes; shift ;;
    --draft) draft=yes; shift ;;
    --no-pr) open_pr=no; shift ;;
    --base)
      (( $# >= 2 )) && [[ "$2" != -* ]] || ai_die 'Missing base REF'
      base=$2; shift 2 ;;
    --max-fix-rounds)
      (( $# >= 2 )) && [[ "$2" =~ ^[0-5]$ ]] || ai_die '--max-fix-rounds must be 0-5'
      max_fix_rounds=$2; shift 2 ;;
    --review-timeout)
      (( $# >= 2 )) || ai_die 'Missing review timeout'
      review_args=(--timeout "$2"); shift 2 ;;
    --sessions|--session-timeout|--run-timeout|--model|--knowledge-dir)
      (( $# >= 2 )) || ai_die "Missing value for $1"
      run_args+=("$1" "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; ai_die "Unknown argument: $1" ;;
  esac
done
[[ "$approved" == yes ]] || ai_die 'Review the plan/permissions/checks, then pass --approved.'
command -v claude >/dev/null || ai_die 'Install and authenticate Claude Code first.'
command -v codex >/dev/null || ai_die 'Install and authenticate Codex CLI first.'
ai_root
exec 7>.ai/local/pipeline.lock
flock -n 7 || ai_die 'Another pipeline is running in this checkout.'
rm -f .ai/local/last-error
AI_START_BRANCH=$(git symbolic-ref --quiet --short HEAD) || ai_die 'Detached HEAD; use a feature branch.'
ai_branch
base_sha=$(git rev-parse --verify --quiet "${base}^{commit}") || ai_die "Invalid base: $base"
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
  ai_die 'Start from a clean checkpoint. Reconcile/commit interrupted changes first.'
# The pipeline holds its own baseline of the gate across all steps.
AI_APPROVED_GATE=$(ai_guard_digest) || ai_die 'Cannot approve missing/unsafe workflow gate.'
readonly AI_APPROVED_GATE
export AI_PIPELINE=1
branch=$AI_START_BRANCH

stop() {
  local stage=$1 reason
  reason=$(cat .ai/local/last-error 2>/dev/null || true)
  ai_notify "Pipeline stopped during $stage on $branch: ${reason:-see terminal}. Rerun ai-pipeline after fixing."
  ai_die "Pipeline stopped during $stage: ${reason:-see output above}"
}
step() { printf '\n== %s ==\n' "$*"; }
count_commits() { git log --oneline "$base_sha..HEAD" --grep="$1" | wc -l; }
# Review is current if nothing but workflow records changed since the reviewed commit.
review_current() {
  local info reviewed
  info=$(ai_helper review-info 2>/dev/null) || return 1
  reviewed=${info%% *}
  git merge-base --is-ancestor "$base_sha" "$reviewed" 2>/dev/null || return 1
  git diff --quiet "$reviewed" HEAD -- . ':!.ai/reviews' ':!.ai/state.md' ':!.ai/run-log.md' ':!.ai/handoff.md'
}

ai_notify "Pipeline started on $branch."
unresolved=0
while true; do
  ai_guard_verify
  if ! ai_helper tasks complete 2>/dev/null; then
    step 'Implementation (Claude)'
    "$AI_BIN/ai-run" --approved "${run_args[@]}" || stop implementation
    ai_guard_verify
  fi
  if ! review_current; then
    if ! ai_helper stamp verify >/dev/null 2>&1; then
      step 'Validation'
      "$AI_BIN/ai-check" || stop validation
    fi
    step 'Independent review (Codex)'
    "$AI_BIN/ai-review" --base "$base" "${review_args[@]}" || stop review
    ai_guard_verify
    git add -- .ai/reviews/current.md
    git commit -m "chore(ai): record independent review" >/dev/null
  fi
  read -r _ blockers majors minors < <(ai_helper review-info)
  printf 'Review: BLOCKER %s, MAJOR %s, MINOR %s\n' "$blockers" "$majors" "$minors"
  (( blockers + majors > 0 )) || break
  fixes=$(count_commits '^chore(ai): record review triage')
  if (( fixes >= max_fix_rounds )); then
    unresolved=1
    printf 'Fix round limit (%s) reached with significant findings; the PR will be a draft.\n' "$max_fix_rounds"
    break
  fi
  step "Review triage, round $(( fixes + 1 )) (Claude)"
  triage_args=()
  for (( i=0; i<${#run_args[@]}; i+=2 )); do
    case "${run_args[i]}" in --model|--knowledge-dir|--session-timeout) triage_args+=("${run_args[i]}" "${run_args[i+1]}") ;; esac
  done
  "$AI_BIN/ai-run" --approved --triage "${triage_args[@]}" || stop triage
  ai_guard_verify
  if ai_helper tasks complete 2>/dev/null; then
    # Claude rejected or deferred every significant finding: the PR shows the dispositions.
    printf '%s\n' 'Triage added no fix tasks; dispositions are recorded in the review.'
    break
  fi
done

ai_guard_verify
reviews=$(count_commits '^chore(ai): record independent review')
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || stop 'pull request preparation'
if [[ "$open_pr" != yes ]]; then
  ai_notify "Done on $branch: validated and reviewed ($reviews review round(s)); no PR requested."
  printf '%s\n' 'Pipeline complete (no PR requested).'
  exit 0
fi
step 'Pull request'
if ! git remote get-url origin >/dev/null 2>&1; then
  ai_notify "Done on $branch, but there is no 'origin' remote to open a PR on."
  printf '%s\n' "No 'origin' remote; branch is ready locally."
  exit 0
fi
git push -u origin "$branch" || { printf '%s\n' 'git push failed' > .ai/local/last-error; stop push; }
if ! command -v gh >/dev/null; then
  ai_notify "Branch $branch pushed. Install the GitHub CLI (gh) to open PRs automatically."
  exit 0
fi
title=$(ai_helper pr-title)
body=$(mktemp .ai/local/pr-XXXXXXXX.md)
ai_helper pr-body "$reviews" "$unresolved" > "$body"
pr_args=(--title "$title" --body-file "$body")
if git show-ref --verify --quiet "refs/heads/$base"; then pr_args+=(--base "$base"); fi
if [[ "$draft" == yes || "$unresolved" == 1 ]]; then pr_args+=(--draft); fi
if url=$(gh pr view "$branch" --json url --jq .url 2>/dev/null) && [[ -n "$url" ]]; then
  gh pr edit "$branch" --body-file "$body" >/dev/null || { printf '%s\n' 'gh pr edit failed' > .ai/local/last-error; stop 'pull request'; }
else
  url=$(gh pr create --head "$branch" "${pr_args[@]}" | tail -n 1) || { printf '%s\n' 'gh pr create failed' > .ai/local/last-error; stop 'pull request'; }
fi
ai_helper state ready_for_acceptance "Human: test and merge the pull request $url"
ai_log none "pull request ready: $url" PASS 'Human acceptance and merge remain'
git add -- .ai/state.md .ai/run-log.md
git commit -m 'chore(ai): record pull request' >/dev/null
git push origin "$branch" >/dev/null 2>&1 || true
if [[ "$unresolved" == 1 ]]; then
  ai_notify "Draft PR needs your attention (unresolved review findings): $url"
else
  ai_notify "PR ready for testing: $url"
fi
printf 'Pull request: %s\n' "$url"
