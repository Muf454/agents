#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
usage() {
  cat <<'EOF'
Usage: ai-pipeline --approved [--base REF] [--pr-base BRANCH] [--max-fix-rounds N]
                   [--draft] [--no-pr] [--review-timeout SECONDS] [--skip-plan-review]
                   [ai-run options: --sessions N --session-timeout S --run-timeout S
                    --model NAME --knowledge-dir DIR]
Hands-off delivery of an approved plan on a feature branch:
  Codex plan review (before any task starts) -> on BLOCKER/MAJOR, supervised (AI_SUPERVISE=1,
  default): Claude revises the plan (ai-run --revise-plan; at most AI_SUPERVISE_PLAN_ROUNDS per
  run, AI_SUPERVISE_ESCALATE_MODEL from review round AI_SUPERVISE_ESCALATE_ROUND) and the plan
  is reviewed again; the limit, a needs-human disposition or AI_SUPERVISE=0 stops for you
  -> implement (ai-run) -> full gate -> independent Codex review (ai-review)
  -> Claude triage + fix tasks (at most N rounds, default 2); Codex re-checks rejected
  BLOCKER/MAJOR findings (upheld ones become disputes) -> review again
  Reviews use Codex; at a Codex usage limit a read-only Claude review instead (AI_REVIEWER=auto|codex|claude).
  With auto, small low-risk fix rounds are reviewed by a fresh Claude session (AI_REVIEW_ROUTE=codex: off).
  -> push the feature branch and open/update a pull request (draft while disputes exist) -> notify.
--base is the review base (default main); a local branch B is replaced by origin/B when
origin/B is strictly ahead of it (never fetched), and the resolved base is printed.
--pr-base is the PR target branch (default: --base when it is a local or origin/ branch).
The human tests and merges the PR. Nothing is merged or deployed. Rerun to resume:
an interrupted review triage is verified and recorded once, and pending re-checks of
rejected findings run, before anything else.
Usage limits pause and resume (see ai-run); a reset beyond AI_LIMIT_MAX_WAIT is relaunched by the
watchdog timer (--recover), at most AI_LIMIT_RELAUNCH_MAX times per run. Notifications use AI_NOTIFY_CMD.
ai-pipeline --stop [CHECKOUT] [--wait SECONDS] stops the checkout's current run (default: this
checkout; waits up to SECONDS, default 60): exit 0 stopped (or recorded as stopped when its process
is already gone), 3 no run to stop, 4 signalled but still ending (rerun to wait again), 1 error.
EOF
}
# Stop the checkout's run (RC-01 G1): found through its run record, never by command line; no
# checkout lock while signalling (the running pipeline holds it). Only a run that ended without
# its own records is completed, under the lock taken with flock -n (run-stop, T319).
if [[ "${1:-}" == --stop ]]; then
  shift
  stop_checkout=. stop_wait=60
  while (( $# )); do
    case "$1" in
      --wait)
        if (( $# < 2 )) || [[ ! "$2" =~ ^[1-9][0-9]{0,3}$ ]]; then
          printf '%s\n' 'Error: --wait must be 1-9999 seconds' >&2; exit 1
        fi
        stop_wait=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) printf 'Error: Unknown argument: %s\n' "$1" >&2; exit 1 ;;
      *)
        [[ "$stop_checkout" == . ]] || { printf '%s\n' 'Error: only one CHECKOUT' >&2; exit 1; }
        stop_checkout=$1; shift ;;
    esac
  done
  stop_root=$(git -C "$stop_checkout" rev-parse --show-toplevel 2>/dev/null) || {
    printf 'Error: Not a Git checkout: %s\n' "$stop_checkout" >&2; exit 1; }
  cd -- "$stop_root"
  [[ -d .ai && ! -L .ai ]] || { printf '%s\n' 'Error: Missing/unsafe .ai directory.' >&2; exit 1; }
  python3 "$AI_BIN/lib/workflow.py" paths "$stop_root"
  exec python3 "$AI_BIN/lib/workflow.py" run-stop --wait "$stop_wait"
fi
orig_args=("$@")
base=main; pr_base=''; max_fix_rounds=2; draft=no; open_pr=yes; approved=no; plan_review=yes
knowledge_dir=''
review_args=(); run_args=()
while (( $# )); do
  case "$1" in
    --approved) approved=yes; shift ;;
    --draft) draft=yes; shift ;;
    --no-pr) open_pr=no; shift ;;
    --skip-plan-review) plan_review=no; shift ;;
    --base)
      (( $# >= 2 )) && [[ "$2" != -* ]] || ai_die 'Missing base REF'
      base=$2; shift 2 ;;
    --pr-base)
      (( $# >= 2 )) && [[ "$2" =~ ^[A-Za-z0-9._/-]+$ ]] || ai_die 'Missing or invalid PR base branch'
      pr_base=$2; shift 2 ;;
    --max-fix-rounds)
      (( $# >= 2 )) && [[ "$2" =~ ^[0-5]$ ]] || ai_die '--max-fix-rounds must be 0-5'
      max_fix_rounds=$2; shift 2 ;;
    --review-timeout)
      (( $# >= 2 )) || ai_die 'Missing review timeout'
      review_args=(--timeout "$2"); shift 2 ;;
    --knowledge-dir)
      (( $# >= 2 )) || ai_die 'Missing knowledge directory'
      [[ -d "$2" ]] || ai_die 'Knowledge directory must already exist.'
      knowledge_dir=$(cd -- "$2" && pwd -P)
      # The run manifest records the resolved path, not one relative to the caller.
      orig_args[${#orig_args[@]} - $# + 1]=$knowledge_dir
      run_args+=("$1" "$knowledge_dir"); shift 2 ;;
    --sessions|--session-timeout|--run-timeout|--model)
      (( $# >= 2 )) || ai_die "Missing value for $1"
      run_args+=("$1" "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; ai_die "Unknown argument: $1" ;;
  esac
done
[[ "$approved" == yes ]] || ai_die 'Review the plan/permissions/checks, then pass --approved.'
command -v claude >/dev/null || ai_die 'Install and authenticate Claude Code first.'
case "${AI_REVIEWER:-auto}" in
  claude) ;;
  codex) command -v codex >/dev/null || ai_die 'Install and authenticate Codex CLI first (or set AI_REVIEWER=auto).' ;;
  auto) command -v codex >/dev/null || printf '%s\n' 'Codex CLI not found: reviews run on the Claude fallback reviewer.' ;;
  *) ai_die "Invalid AI_REVIEWER: $AI_REVIEWER (auto, codex or claude)" ;;
esac
ai_review_route_settings
ai_supervise_settings
ai_root
# Host authority state must live where agent sessions cannot write; checked before any agent.
state_error=$(ai_helper state-root-check ${knowledge_dir:+"$knowledge_dir"} 2>&1) || \
  ai_die "${state_error#Error: }"
# The pipeline owns the shared checkout lock for its whole run; its children inherit it.
ai_lock
export AI_LOCK_HELD=$$
rm -f .ai/local/last-error
# A human stop (Ctrl-C, kill -TERM, a service stop) is recorded as such, never auto-recovered;
# trapped before the marker exists so no interrupt leaves it behind. AI_STAGE is the step key.
# Long children (ai-run, ai-review, ai-check, retry sleeps, git push, git ls-remote, gh) run
# through ai_run_child or ai_run_capture, so a signal to this pid alone ends them too.
AI_STAGE=start
trap 'ai_human_stop INT' INT
trap 'ai_human_stop TERM' TERM
# Liveness marker for ai-watchdog: removed by ai_die and finish, so one left behind
# with no runner alive means the pipeline was killed or the machine restarted.
AI_PIPELINE_MARKER=.ai/local/pipeline.active
printf '%s\n' "$$" > "$AI_PIPELINE_MARKER"
[[ -n "${AI_RECOVERY_ATTEMPT:-}" ]] || ai_observe start
finish() {
  ai_observe done "${1:-no PR}"
  # Keeps the manifest's timeout reruns: a pipeline resumed under the same approval must not
  # get another commit-and-rerun for a task; only a human (re)start resets them.
  ai_helper run-manifest clear-attempts 2>/dev/null || true
  [[ -z "${pub_out:-}" ]] || rm -f -- "$pub_out" 2>/dev/null || true
  ai_helper run-record end --run "$AI_RUN_ID" --pid $$ finished "${1:-no PR}" 2>/dev/null || \
    printf 'Warning: could not record the end of run %s.\n' "$AI_RUN_ID" >&2
  ai_drop_marker
  exit 0
}
AI_START_BRANCH=$(git symbolic-ref --quiet --short HEAD) || ai_die 'Detached HEAD; use a feature branch.'
ai_branch
# A local base branch that is behind origin/<base> would make the review cover already
# merged work: review against origin/<base> when it is strictly ahead. Never fetches.
base_ref=$base base_note=''
if git show-ref --verify --quiet "refs/heads/$base" && \
   git show-ref --verify --quiet "refs/remotes/origin/$base" && \
   [[ "$(git rev-parse "refs/heads/$base")" != "$(git rev-parse "refs/remotes/origin/$base")" ]]; then
  if git merge-base --is-ancestor "refs/heads/$base" "refs/remotes/origin/$base"; then
    base_ref=origin/$base base_note=" (local $base is behind)"
  elif ! git merge-base --is-ancestor "refs/remotes/origin/$base" "refs/heads/$base"; then
    printf 'Local %s and origin/%s have diverged; reviewing against local %s.\n' "$base" "$base" "$base"
  fi
fi
base_sha=$(git rev-parse --verify --quiet "${base_ref}^{commit}") || ai_die "Invalid base: $base"
base_label="$base_ref ($(git rev-parse --short "$base_sha"))"
printf 'Review base: %s at %s%s\n' "$base_ref" "$(git rev-parse --short "$base_sha")" "$base_note"
# A dispute file unchanged since the merge-base was merged by the human: historical, not active.
export AI_DISPUTES_BASE=$base_sha
if [[ "$open_pr" == yes && -z "$pr_base" ]]; then
  # The PR must target the branch the review compared against; never guess.
  if git show-ref --verify --quiet "refs/heads/$base"; then pr_base=$base
  elif [[ "$base" == origin/* ]] && git show-ref --verify --quiet "refs/remotes/$base"; then pr_base=${base#origin/}
  else ai_die "Cannot infer the PR target from --base $base; pass --pr-base BRANCH."
  fi
fi
# An interrupted stage of this branch (host-side, per branch, so runs on other branches
# neither drop nor inherit it) is completed below, before anything else; its leftovers are
# checked there. An uncommitted re-check report (a stop before its host commit) is verified
# and committed by the dispute reconciliation below. Otherwise start from a clean checkpoint,
# or, on the usage-limit relaunch's resume, from exactly the preserved task work it armed.
open_stage=$(ai_helper run-manifest stage 2>&1) || ai_die "Cannot read this branch's open stage: ${open_stage#Error: }"
# Armed-tree acceptance contract: the path from the relaunch's `exec ai-pipeline` to ai-run's
# `limit-disarm` (docs/workflow.md "What the resumed run does with preserved work").
# 1. One predicate: every check on that path that requires a clean checkout is `clean_or_armed`
#    (lib/common.sh): here, both tests of reconcile_disputes, ai-run's start check.
# 2. No host write while armed: no commit and no tracked write before the disarm. Where the path
#    could commit (reconcile_disputes), the armed tree is admitted only with nothing to record,
#    else it stops before the write (the fail-closed stop of rule 6).
# 3. One consumer: ai-run's `limit-disarm` (one call site); after it the normal rules apply
#    unchanged (ai-check, checkpoint-guard, committed-matches-worktree, the no_checkpoint stop).
# 4. Matrix, not sites: tests `test_limit_relaunch_accept_*` cover the resume-path states.
# 5. An armed resume re-enters at implementation: no earlier stage (plan review or plan
#    revision, the queue repair) runs on an armed tree (`! armed_resume` guards).
# 6. An armed manifest is terminal for recovery: every stop between the resume and the disarm is
#    one ⛔ with nothing committed, whatever its reason and AI_AUTO_RECOVER (ai-recover).
# 7. The consumer runs after ai-run's complete startup, dependency setup included.
# 8. The arm ends at the act: every check of the consumer runs armed and is therefore terminal;
#    `limit-disarm` is the last statement before the armed checkpoint or the first session.
# A new cleanliness check, commit, review or session on this path uses `clean_or_armed`, the
# fail-closed stop or the `! armed_resume` guard and extends the matrix; a new check of the
# consumer goes before the disarm.
[[ -n "$open_stage" || -z "$(git status --porcelain --untracked-files=all -- . \
    ':!.ai/reviews/recheck.md' ':!.ai/reviews/disputes.md' ':!.ai/reviews/fallback-log.md')" ]] || clean_or_armed || \
  ai_die 'Start from a clean checkpoint. Reconcile/commit interrupted changes first.'
# The pipeline holds its own baseline of the gate across all steps.
AI_APPROVED_GATE=$(ai_guard_digest) || { AI_GATE_BROKEN=1; ai_die 'Cannot approve missing/unsafe workflow gate.'; }
readonly AI_APPROVED_GATE
if [[ -n "${AI_RECOVERY_ATTEMPT:-}" ]]; then
  # A resume must run under the gate and branch the human approved (host-side manifest).
  [[ "$AI_APPROVED_GATE" == "$(ai_helper run-manifest gate 2>/dev/null)" ]] || \
    { AI_GATE_BROKEN=1; ai_die 'Gate files changed since the run was approved; rerun ai-pipeline --approved yourself.'; }
  [[ "$AI_START_BRANCH" == "$(ai_helper run-manifest branch 2>/dev/null)" ]] || \
    ai_die 'Resumed on a different branch than the approved run.'
  # The resumed pipeline holds the checkout lock, so the current run record is this run's.
  # A named run (AI_RUN_ID) must resume. Without one, a current record that refuses only
  # stops the resume on a stop request; no record, or an ended one without a stop request,
  # means the approved run has none yet (approved before run records): start its record.
  refused='The run record refuses this resume (stopped by you or replaced); rerun ai-pipeline --approved yourself.'
  if [[ -n "${AI_RUN_ID:-}" ]]; then
    ai_helper run-record resume --run "$AI_RUN_ID" --pid $$ || ai_die "$refused"
  elif AI_RUN_ID=$(ai_helper run-record current 2>/dev/null) && \
       ai_helper run-record resume --run "$AI_RUN_ID" --pid $$ 2>/dev/null; then
    :
  else
    [[ -z "$AI_RUN_ID" ]] || ! ai_helper run-record stop-requested --run "$AI_RUN_ID" 2>/dev/null || ai_die "$refused"
    printf 'No run record to resume; recording this resumed run.\n'
    AI_RUN_ID=$(ai_helper run-record start pipeline "$AI_START_BRANCH" "$base_ref" "$base_sha" \
      --pid $$ -- "${orig_args[@]}") || ai_die 'Cannot record the run in the host state directory.'
  fi
else
  # A human (re)start: record the approved run and give it a fresh recovery budget.
  ai_helper run-manifest start "$AI_APPROVED_GATE" "$AI_START_BRANCH" "${orig_args[@]}" || \
    ai_die 'Cannot record the run manifest in the host state directory.'
  # The run record is required: no controlled work runs without it.
  AI_RUN_ID=$(ai_helper run-record start pipeline "$AI_START_BRANCH" "$base_ref" "$base_sha" \
    --pid $$ -- "${orig_args[@]}") || ai_die 'Cannot record the run in the host state directory.'
fi
[[ "$AI_RUN_ID" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]{1,10}-[0-9]{1,9}$ ]] || ai_die "Invalid run id: $AI_RUN_ID"
export AI_RUN_ID
export AI_PIPELINE=1
branch=$AI_START_BRANCH
ai_helper pipeline-register "$AI_ROOT" "$AI_START_BRANCH" || \
  printf 'Warning: could not register this checkout for ai-dashboard.\n' >&2
# Fix rounds are counted from host state, never from commit subjects agents can choose.
ai_helper fix-rounds init "$base_sha" || ai_die 'Cannot record the fix rounds in the host state directory.'

stop() {
  local stage=$1 reason
  reason=$(cat .ai/local/last-error 2>/dev/null || true)
  reason=${reason:-see terminal}
  # Sets AI_GATE_BROKEN on a changed gate, so no project helper records this stop.
  local gate_ok=no; if ai_gate_check "$AI_APPROVED_GATE"; then gate_ok=yes; fi
  # A run whose stop was requested (ai-pipeline --stop, a signal) is a human stop, never recovered.
  if [[ "$gate_ok" == yes ]] && ai_helper run-record stop-requested --run "$AI_RUN_ID" 2>/dev/null; then
    ai_human_stop TERM
  fi
  ai_observe stop "$stage" "$reason"
  # Only hand over to checkout code that is still exactly the approved gate.
  if [[ "${AI_AUTO_RECOVER:-1}" != 0 && -x "$AI_BIN/ai-recover" && "$gate_ok" == yes ]]; then
    # Bounded auto-recovery takes over this process (same PID, lock and marker).
    [[ -s .ai/local/last-error ]] || printf '%s\n' "stopped during $stage (see terminal)" > .ai/local/last-error
    exec "$AI_BIN/ai-recover" --stage "$stage"
  fi
  AI_STOP_NOTIFIED=1
  ai_notify "⛔ STOPPED, needs you: $branch stopped during $stage: ${reason%.}. Fix it, then rerun ai-pipeline."
  ai_die "Pipeline stopped during $stage: ${reason:-see output above}"
}
# step KEY TITLE [DETAIL]: KEY is the dashboard box recorded for the stage.
step() { AI_STAGE=$1; printf '\n== %s ==\n' "$2"; ai_observe step "$1" "${@:3}"; }
count_commits() { git log --oneline "$base_sha..HEAD" --grep="$1" | wc -l; }
# Commit host records, then re-verify before any project-local helper runs again
# (commit hooks could otherwise swap gate code in between).
host_commit() {
  git add -- "${@:2}"
  git commit -m "$1" >/dev/null
  ai_guard_verify
}
# A Claude fallback review appends to the fallback log, a format retry to the run log:
# commit them with the review record.
review_record() {
  local paths=("$@")
  [[ -z "$(git status --porcelain --untracked-files=all -- .ai/reviews/fallback-log.md)" ]] || \
    paths+=(.ai/reviews/fallback-log.md)
  [[ -z "$(git status --porcelain -- .ai/run-log.md)" ]] || paths+=(.ai/run-log.md)
  printf '%s\n' "${paths[@]}"
}
# Review is current if nothing but workflow records changed since the reviewed commit.
review_current() {
  local info reviewed
  info=$(ai_helper review-info 2>/dev/null) || return 1
  reviewed=${info%% *}
  git merge-base --is-ancestor "$base_sha" "$reviewed" 2>/dev/null || return 1
  git diff --quiet "$reviewed" HEAD -- . ':!.ai/reviews' ':!.ai/state.md' ':!.ai/run-log.md' ':!.ai/handoff.md'
}
# The base must be contained in the branch, or no review of it can ever be current.
base_reached() { git merge-base --is-ancestor "$base_sha" HEAD 2>/dev/null; }
base_moved="Review base $base_label moved past the branch; merge it into $branch and rerun ai-pipeline"
# Publish invariants: what gets published is exactly what was reviewed and validated.
# Checked after host commits on the publish path, before and after every push attempt
# (commit and push hooks run project code); any failure stops. The committed bytes come
# before "review current" so a hook commit with filtered bytes is reported as such.
publish_ready() {
  local why=''
  ai_guard_verify
  if ! why=$(ai_helper review-info 2>&1 >/dev/null); then why=${why#Error: }; why=${why:-review integrity check failed}
  elif ! why=$(ai_helper disputes-verify 2>&1 >/dev/null); then why=${why#Error: }; why=${why:-dispute records do not verify}
  elif [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then why='the checkout is not clean'
  elif ! why=$(ai_helper committed-matches-worktree 2>&1 >/dev/null); then why="committed content differs from the validated content: ${why#Error: }"
  elif ! ai_helper tasks complete >/dev/null 2>&1; then why='not all tasks are DONE'
  elif ! base_reached; then why=$base_moved
  elif ! review_current; then why='the review is not current for HEAD (reviewed content changed)'
  elif ! ai_helper stamp verify >/dev/null 2>&1; then why='the validation stamp is not current for HEAD'
  else return 0
  fi
  printf 'Publish check failed at %s: %s\n' "$1" "${why%.}" > .ai/local/last-error
  stop "$1"
}
# Publication commands whose output is read (git ls-remote, gh) run through ai_run_capture into
# one ignored file, made at first use and removed by finish and ai_human_stop. Usage: pub_capture CMD...
pub_out=''
pub_capture() {
  [[ -n "$pub_out" ]] || pub_out=$(mktemp .ai/local/publish-XXXXXXXX.out) || { pub_out=''; return 1; }
  ai_run_capture "$pub_out" "$@"
}
# pub_capture, then the output (trailing newlines stripped, empty without a file) in pub_text;
# returns the command's status. Usage: pub_read CMD...
pub_text=''
pub_read() {
  local code=0
  pub_text=''
  pub_capture "$@" || code=$?
  [[ -z "$pub_out" ]] || pub_text=$(< "$pub_out")
  return "$code"
}
# Pushes hit transient network/auth hiccups; retry before treating it as a stop.
# Usage: push STAGE FAILURE-MESSAGE git-push-args...; afterwards origin's branch is HEAD.
# Push hooks run project code, so the publish checks run after EVERY attempt, failed or
# not: a hook's change is reported as such, never as a (retryable) push failure.
push() {
  local stage=$1 failed=$2 try ok remote; shift 2
  for try in 1 2 3; do
    publish_ready "$stage"
    ok=0
    if ai_run_child git push "$@"; then ok=1; fi
    publish_ready "$stage"
    (( ok )) && break
    if (( try == 3 )); then printf '%s\n' "$failed" > .ai/local/last-error; stop "$stage"; fi
    ai_run_child ${AI_SLEEP:-sleep} $(( try * 20 ))
  done
  remote=''
  if pub_capture git ls-remote origin "refs/heads/$branch"; then
    remote=$(awk -v ref="refs/heads/$branch" '$2 == ref { print $1 }' "$pub_out") || remote=''
  fi
  [[ "$remote" == "$(git rev-parse HEAD)" ]] || {
    printf 'Publish check failed after %s: origin %s is %s, not HEAD %s (push hook?)\n' \
      "$stage" "$branch" "${remote:-missing}" "$(git rev-parse --short HEAD)" > .ai/local/last-error
    stop "$stage"
  }
}
ensure_validated() {
  if ! ai_helper stamp verify >/dev/null 2>&1; then
    step checks 'Validation'
    ai_run_child "$AI_BIN/ai-check" || { ai_escalation_hint validation; stop validation; }
    ai_guard_verify
  fi
}
triage_args=()
for (( i=0; i<${#run_args[@]}; i+=2 )); do
  case "${run_args[i]}" in --model|--knowledge-dir|--session-timeout) triage_args+=("${run_args[i]}" "${run_args[i+1]}") ;; esac
done
# A failed stage check always needs the human (ai-recover escalates "Triage stage" stops).
stage_fail() {
  printf 'Triage stage cannot be completed safely: %s\n' "${1#Error: }" > .ai/local/last-error
  stop triage
}
# Completes the open triage stage exactly once, on every start, resume and triage round:
# verify the review binding and that only workflow records changed since the stage started,
# then close it if its counted commit exists, else record the round through ai-run --triage.
complete_stage() {
  local info state start
  info=$(ai_helper run-manifest stage 2>&1) || stage_fail "$info"
  [[ -n "$info" ]] || return 0
  state=$(ai_helper stage-verify 2>&1) || stage_fail "$state"
  if [[ "$state" != committed ]]; then
    read -r _ start _ <<< "$info"
    ai_run_child "$AI_BIN/ai-run" --approved --triage --since "$start" "${triage_args[@]}" || stop triage
    ai_guard_verify
    state=$(ai_helper stage-verify 2>&1) || stage_fail "$state"
    [[ "$state" == committed ]] || stage_fail 'the triage round was not recorded.'
  fi
  state=$(ai_helper triage-check --fresh 2>&1) || stage_fail "$state"
  ai_helper run-manifest stage-clear || stage_fail 'cannot clear the stage in the run manifest.'
}
# The revision gets its model from the round, never from --model: opus, or the escalation
# model from AI_SUPERVISE_ESCALATE_ROUND on (settings restored from the manifest on resume).
plan_revision_args=()
for (( i=0; i<${#triage_args[@]}; i+=2 )); do
  [[ "${triage_args[i]}" == --model ]] || plan_revision_args+=("${triage_args[i]}" "${triage_args[i+1]}")
done
plan_revision_model() {
  local current round
  current=$(ai_helper plan-rounds current "$base_sha") || return 1
  read -r round _ <<< "$current"
  if (( round >= AI_SUPERVISE_ESCALATE_ROUND )); then
    printf '%s\n' "$AI_SUPERVISE_ESCALATE_MODEL"
  else
    printf '%s\n' opus
  fi
}
# A failed plan revision stage check always needs the human (ai-recover escalates it).
plan_stage_fail() {
  printf 'Plan revision stage cannot be completed safely: %s\n' "${1#Error: }" > .ai/local/last-error
  stop 'plan revision'
}
# Completes the open plan revision stage exactly once (fresh start and resume alike): close
# it when its host revision record exists, else reserve the revision (idempotent per report)
# and record it through ai-run --revise-plan. Writes nothing to the checkout itself.
complete_plan_stage() {
  local info state start digest model
  info=$(ai_helper run-manifest stage 2>&1) || plan_stage_fail "$info"
  [[ -n "$info" ]] || return 0
  state=$(ai_helper stage-verify 2>&1) || plan_stage_fail "$state"
  if [[ "$state" != committed ]]; then
    read -r _ start digest <<< "$info"
    if ! state=$(ai_helper run-manifest revision-reserve "$digest" "$AI_SUPERVISE_PLAN_ROUNDS" 2>&1); then
      printf '%s\n' "${state#Error: }" > .ai/local/last-error
      ai_escalation_hint plan_review_limit
      stop 'plan revision'
    fi
    model=$(plan_revision_model 2>&1) || plan_stage_fail "$model"
    ai_run_child "$AI_BIN/ai-run" --approved --revise-plan --since "$start" --base "$base_sha" --model "$model" \
      "${plan_revision_args[@]}" || stop 'plan revision'
    ai_guard_verify
    state=$(ai_helper stage-verify 2>&1) || plan_stage_fail "$state"
    [[ "$state" == committed ]] || plan_stage_fail 'the plan revision was not recorded.'
  fi
  ai_helper run-manifest stage-clear || plan_stage_fail 'cannot clear the stage in the run manifest.'
}
recheck_fail() {
  printf 'Re-check of rejected findings: %s\n' "${1#Error: }" > .ai/local/last-error
  stop 're-check'
}
# Disputed findings (after every triage and on every start/resume, before any task runs or
# the review is replaced): rejected BLOCKER/MAJOR without a verified, current re-check get
# one; every upheld answer gets its append-only dispute record, committed with the re-check
# report in one host commit. Rerunning it adds nothing twice.
reconcile_disputes() {
  local status added paths=() file
  status=$(ai_helper recheck-status 2>&1) || recheck_fail "$status"
  # Preserved task work is admitted only with nothing to record (no host write while armed):
  # a pending re-check, dirty review records or a dispute the host has not recorded yet stop
  # before the re-check, the record or the commit.
  if [[ "$status" == pending || -n "$(git status --porcelain --untracked-files=all -- \
        .ai/reviews/recheck.md .ai/reviews/disputes.md .ai/reviews/fallback-log.md)" ]] && armed_resume; then
    recheck_fail 'preserved task work carries uncommitted review records; inspect them.'
  fi
  if [[ "$status" == verified ]] && armed_resume && ! ai_helper disputes-record --check >/dev/null 2>&1; then
    recheck_fail 'preserved task work carries uncommitted review records; inspect them.'
  fi
  # The fallback log is appended by every Claude review and committed with the next record.
  if [[ "$status" != verified && -n "$(git status --porcelain --untracked-files=all -- . ':!.ai/reviews/fallback-log.md')" ]] && \
      ! clean_or_armed; then
    recheck_fail 'uncommitted .ai/reviews/recheck.md or disputes.md that do not verify; inspect them.'
  fi
  [[ "$status" != none ]] || return 0
  if [[ "$status" == pending ]]; then
    step recheck 'Re-check of rejected findings (Codex; Claude fallback)'
    ai_run_child "$AI_BIN/ai-review" --recheck "${review_args[@]}" || stop 're-check'
    ai_guard_verify
  fi
  added=$(ai_helper disputes-record 2>&1) || recheck_fail "$added"
  for file in .ai/reviews/recheck.md .ai/reviews/disputes.md .ai/reviews/fallback-log.md; do
    [[ -z "$(git status --porcelain --untracked-files=all -- "$file")" ]] || paths+=("$file")
  done
  if (( ${#paths[@]} )); then
    if [[ " ${paths[*]} " == *recheck.md* ]]; then
      host_commit 'chore(ai): record review re-check' "${paths[@]}"
    else
      host_commit 'chore(ai): record disputed findings' "${paths[@]}"
    fi
  fi
  # A commit hook must not have changed the re-check, the records or anything else.
  [[ "$(ai_helper recheck-status 2>/dev/null)" == verified ]] || recheck_fail 'the re-check no longer verifies after its commit (commit hook?).'
  status=$(ai_helper disputes-verify 2>&1) || recheck_fail "$status"
  clean_or_armed || recheck_fail 'the checkout is not clean after recording it.'
  if (( added > 0 )); then printf 'Recorded %s disputed finding(s); the PR will be a draft.\n' "$added"; fi
}

# A missing watchdog timer never stops the run, but the human should know at the start.
timer_note=''
timer_state=$("$AI_BIN/ai-watchdog" "$PWD" --timer-status 2>/dev/null </dev/null) && timer_rc=0 || timer_rc=$?
case "$timer_rc" in
  0) ;;
  1) printf 'No watchdog timer for this checkout; a crash or restart would go unnoticed. Install it: .ai/bin/ai-watchdog --install-timer --diagnose --recover\n'
     timer_note=' (no watchdog timer for this checkout)' ;;
  *) printf 'Watchdog timer status unknown: %s\n' "${timer_state:-no answer}"
     timer_note=' (watchdog timer status unknown)' ;;
esac
if [[ -n "${AI_RECOVERY_ATTEMPT:-}" ]]; then
  ai_notify "▶ RESUMED on $branch after auto-recovery ($AI_RECOVERY_ATTEMPT).$timer_note"
else
  ai_notify "▶ STARTED on $branch.$timer_note"
fi
# Did this process just complete a plan revision stage? (the "Plan revised" notification)
plan_revised=no
if [[ "$open_stage" == 'plan-revision '* ]]; then
  step plan_revision 'Completing the interrupted plan revision' resumed
  # The round (revision model) needs the record of a plan review whose host commit is made.
  ai_helper plan-rounds sync "$base_sha" || plan_stage_fail 'cannot read the host plan review records.'
  complete_plan_stage
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
    plan_stage_fail 'the checkout is not clean after completing the plan revision.'
  plan_revised=yes
elif [[ -n "$open_stage" ]]; then
  step triage 'Completing the interrupted review triage'
  complete_stage
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
    stage_fail 'the checkout is not clean after completing the triage.'
fi
reconcile_disputes
# Settled above (they act on the published review only), so the human's merge never lands
# in an open stage. The base is fixed for the run and HEAD only gains commits: check once.
if ! base_reached; then
  printf '%s\n' "$base_moved" > .ai/local/last-error
  stop start
fi
# A recorded needs-human revision of the current plan review stops for the human (host record,
# also after a crash); it clears only when a new plan review replaces the report. Checked on
# every start whatever --skip-plan-review or the task queue say, in the plan review loop and
# again before implementation: skipping the optional review never skips the decision.
plan_decision_check() {
  local questions rc=0 current
  questions=$(ai_helper plan-revisions decision 2>&1) || rc=$?
  case "$rc" in
    0) ai_observe step plan_revision 'needs your decision'
       # The round number only labels the stop, so a failed sync just leaves it unknown.
       ai_helper plan-rounds sync "$base_sha" >/dev/null 2>&1 || true
       current=$(ai_helper plan-rounds current "$base_sha" 2>/dev/null) || current='?'
       printf 'plan review needs your decision (round %s): %s\n' "${current%% *}" "${questions//$'\n'/; }" \
         > .ai/local/last-error
       # shellcheck disable=SC2046
       ai_escalation_hint needs_human_question $(grep -oE '\b[A-Z]{1,3}[0-9]{1,4}\b' <<< "$questions" | sort -u | sed 's/^/--finding /')
       stop 'plan review' ;;
    1) ;;
    *) plan_stage_fail "the plan revision records are unreadable (${questions#Error: })." ;;
  esac
}
plan_decision_check
# Plan review: cheapest place to catch gaps, before any Claude usage is spent. Supervised
# (AI_SUPERVISE=1), a BLOCKER/MAJOR verdict gets a bounded plan revision (at most
# AI_SUPERVISE_PLAN_ROUNDS per run) and every revision a fresh review on a clean checkout.
# An invalid queue stops here, review on or off: nothing downstream can use it.
queue_stage='plan review'; [[ "$plan_review" == yes ]] || queue_stage=implementation
# An interrupted revision's uncommitted out-of-order queue is repaired first (the helper
# decides); a committed out-of-order queue still stops below. Never on preserved task work
# (no host write while armed).
if [[ "$plan_review" == yes ]] && ! armed_resume; then
  repair_out=$(ai_helper revision-queue-repair 2>&1) || {
    printf 'Plan revision stage: task queue is invalid: %s\n' "${repair_out#Error: }" > .ai/local/last-error
    stop 'plan revision'
  }
  [[ -z "$repair_out" ]] || printf '%s\n' "$repair_out"
fi
# Pre-flight (BR-02): a committed queue whose only faults are the order of TODO tasks or their
# empty sections is repaired once per task per run and committed with its Ruling rows (a stale
# plan review is then reviewed again); anything else stops at the queue check below as before.
if ! armed_resume && [[ -z "$(git status --porcelain --untracked-files=all)" ]] && \
    ai_queue_ruling preflight; then
  host_commit 'chore(ai): ruling: task queue' .ai/tasks.md .ai/run-log.md
fi
queue_error=$(ai_helper tasks check 2>&1 >/dev/null) || {
  printf 'Task queue is invalid: %s\n' "${queue_error#Error: }" > .ai/local/last-error
  stop "$queue_stage"
}
# An armed resume re-enters at implementation: the arm is bound to an `implementation` stop,
# which exists only after this loop broke out in the same run. A committed partial checkpoint
# makes plan-review-info stale and ai-review --plan cannot run on the preserved tree; the
# committed part is reviewed by the implementation review like any task commit.
if [[ "$plan_review" == yes ]] && ! armed_resume && ai_helper tasks untouched 2>/dev/null; then
  while true; do
    ai_helper plan-rounds sync "$base_sha" || stop 'plan review'
    plan_decision_check
    if [[ "$plan_revised" == yes ]]; then
      # Counts from the host record; its run-log line is already in the revision commit, so
      # nothing is written to the checkout before the re-review.
      outcome=$(ai_helper plan-revisions outcome 2>/dev/null) || plan_stage_fail 'the plan revision was not recorded.'
      read -r _ revised_accepted revised_rejected _ <<< "$outcome"
      revised_n=$(ai_helper run-manifest revision-count 2>/dev/null) || revised_n='?'
      revised_round="round $revised_n/$AI_SUPERVISE_PLAN_ROUNDS"
      # 0: a human restart closed the previous run's recorded revision (not counted again).
      [[ "$revised_n" != 0 ]] || revised_round='in the previous run'
      ai_notify "🔁 Plan revised ($revised_round): accepted $revised_accepted, rejected $revised_rejected"
      plan_revised=no
    fi
    # Review needed: no current verified review, or the current one was already revised.
    review_due=no
    if ! plan_info=$(ai_helper plan-review-info 2>/dev/null) || [[ "$plan_info" != current* ]]; then
      review_due=yes
    else
      revised_rc=0
      ai_helper plan-revisions revised >/dev/null 2>&1 || revised_rc=$?
      case "$revised_rc" in
        0) review_due=yes ;;
        1) ;;
        *) plan_stage_fail 'the plan revision records are unreadable.' ;;
      esac
    fi
    if [[ "$review_due" == yes ]]; then
      step plan_review 'Plan review (Codex; Claude fallback)'
      ai_run_child "$AI_BIN/ai-review" --plan --base "$base_sha" "${review_args[@]}" || stop 'plan review'
      ai_guard_verify
      mapfile -t records < <(review_record .ai/reviews/plan.md)
      host_commit 'chore(ai): record plan review' "${records[@]}"
      plan_info=$(ai_helper plan-review-info) || stop 'plan review'
      # A commit hook that changed reviewed content would make the verdict stale.
      [[ "$plan_info" == current* ]] || \
        { printf '%s\n' 'reviewed content changed while recording the plan review (commit hook?)' > .ai/local/last-error; stop 'plan review'; }
      # Records the host commit just made (the newest host-subject commit holding this report).
      ai_helper plan-rounds sync "$base_sha" || stop 'plan review'
      ai_helper plan-rounds current "$base_sha" >/dev/null || stop 'plan review'
    fi
    read -r _ plan_blockers plan_majors _ <<< "$plan_info"
    (( plan_blockers + plan_majors > 0 )) || break
    if [[ "$AI_SUPERVISE" != 1 ]]; then
      printf '%s\n' "plan review found BLOCKER $plan_blockers, MAJOR $plan_majors; revise the plan (see .ai/reviews/plan.md) or rerun with --skip-plan-review" > .ai/local/last-error
      ai_escalation_hint plan_review_limit
      stop 'plan review'
    fi
    current=$(ai_helper plan-rounds current "$base_sha") || stop 'plan review'
    # Reserved before the stage opens (a crash in between finds it reserved, never counted twice).
    if ! reserved=$(ai_helper run-manifest revision-reserve "${current#* }" "$AI_SUPERVISE_PLAN_ROUNDS" 2>&1); then
      printf '%s; BLOCKER %s, MAJOR %s remain\n' "${reserved#Error: }" "$plan_blockers" "$plan_majors" > .ai/local/last-error
      ai_escalation_hint plan_review_limit
      stop 'plan review'
    fi
    step plan_revision "Plan revision $reserved/$AI_SUPERVISE_PLAN_ROUNDS, review round ${current%% *} (Claude)" \
      "$reserved/$AI_SUPERVISE_PLAN_ROUNDS · round ${current%% *}"
    ai_helper run-manifest stage-set plan-revision "$(git rev-parse HEAD)" || stop 'plan revision'
    complete_plan_stage
    ai_guard_verify
    [[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
      plan_stage_fail 'the checkout is not clean after completing the plan revision.'
    plan_revised=yes
  done
fi
plan_decision_check
while true; do
  # Derived from the current review each round, so an earlier deferral doesn't stick.
  unresolved=0
  ai_guard_verify
  # Armed, ai-run always runs: it consumes the preserved work (a task DONE before the limit is
  # checkpointed there), so the review and publish path never meets the dirty tree.
  if ! ai_helper tasks complete 2>/dev/null || armed_resume; then
    step build 'Implementation (Claude)'
    ai_run_child "$AI_BIN/ai-run" --approved "${run_args[@]}" || stop implementation
    ai_guard_verify
  fi
  if ! review_current; then
    ensure_validated
    # Codex reviews the committed range: it must hold exactly the validated bytes.
    if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
      printf '%s\n' 'Committed content differs from the validated content: the checkout is not clean' > .ai/local/last-error
      stop review
    elif ! why=$(ai_helper committed-matches-worktree 2>&1 >/dev/null); then
      printf 'Committed content differs from the validated content: %s\n' "${why#Error: }" > .ai/local/last-error
      stop review
    fi
    step review 'Independent review (Codex; Claude fallback)'
    ai_run_child "$AI_BIN/ai-review" --base "$base_sha" "${review_args[@]}" || stop review
    ai_guard_verify
    mapfile -t records < <(review_record .ai/reviews/current.md)
    host_commit 'chore(ai): record independent review' "${records[@]}"
  fi
  read -r _ blockers majors minors < <(ai_helper review-info)
  printf 'Review: BLOCKER %s, MAJOR %s, MINOR %s\n' "$blockers" "$majors" "$minors"
  (( blockers + majors > 0 )) || break
  # Dispositions for this exact review already complete (e.g. a rerun after triage)?
  if verdict=$(ai_helper triage-check 2>/dev/null) && ai_helper tasks complete 2>/dev/null; then
    read -r accepted deferred <<< "${verdict//[a-z=]/ }"
    # Accepted fixes always need a new review; if the review is still current, the
    # "fixes" changed nothing reviewable: hand it to the human as a draft.
    if (( accepted > 0 || deferred > 0 )); then unresolved=1; fi
    printf 'Findings already triaged (%s) and the review is still current.\n' "$verdict"
    break
  fi
  fixes=$(ai_helper fix-rounds count "$base_sha") || stop review
  extra=''
  if (( fixes >= max_fix_rounds )); then
    # Supervised, one extra round per run when the host-verified BLOCKER+MAJOR counts fall
    # strictly over the last two rounds and this review; reserved before its triage starts.
    extra_reserved=$(ai_helper run-manifest extra-round) || stop review
    digest=$(sha256sum .ai/reviews/current.md | cut -d' ' -f1)
    if [[ "$AI_SUPERVISE" == 1 && "$fixes" == "$max_fix_rounds" && "$extra_reserved" == "$digest" ]]; then
      extra='resumed'
    elif [[ "$AI_SUPERVISE" == 1 && "$fixes" == "$max_fix_rounds" && -z "$extra_reserved" ]] && \
         trend=$(ai_helper fix-rounds trend "$base_sha" 2>/dev/null); then
      read -r trend_x trend_y trend_z <<< "$trend"
      if (( trend_x > trend_y && trend_y > trend_z )); then
        ai_helper run-manifest extra-round-reserve "$digest" || stop review
        extra="$trend_x → $trend_y → $trend_z"
        # Before the stage opens: a crash here leaves a clean checkout and the reservation.
        ai_notify "🔁 Extra fix round: findings falling ($extra)"
      fi
    fi
    if [[ -z "$extra" ]]; then
      unresolved=1
      printf 'Fix round limit (%s) reached with significant findings; the PR will be a draft.\n' "$max_fix_rounds"
      break
    fi
  fi
  triage_detail="round $(( fixes + 1 ))"
  case "$extra" in '') ;; resumed) triage_detail+=' · extra' ;; *) triage_detail+=" · extra ($extra)" ;; esac
  step triage "Review triage, round $(( fixes + 1 )) (Claude)" "$triage_detail"
  # Recorded before triage starts, so a stop or crash anywhere in it resumes this stage.
  ai_helper run-manifest stage-set triage "$(git rev-parse HEAD)" || stop triage
  # The triage commit carries this line (the run log is a triage record).
  [[ -z "$extra" ]] || ai_log none "extra fix round $(( fixes + 1 )): findings falling (${extra/#resumed/reserved before a restart})" 'n/a' \
    "beyond --max-fix-rounds $max_fix_rounds; once per run"
  complete_stage
  verdict=$(ai_helper triage-check --fresh) || stop triage
  reconcile_disputes
  read -r accepted deferred <<< "${verdict//[a-z=]/ }"
  if (( accepted == 0 )); then
    # Every significant finding was rejected (with evidence) or deferred.
    if (( deferred > 0 )); then unresolved=1; fi
    printf 'Triage added no fix tasks (%s); dispositions are recorded.\n' "$verdict"
    break
  fi
done

ai_guard_verify
ensure_validated
reviews=$(count_commits '^chore(ai): record independent review')
publish_ready 'pull request preparation'
if [[ "$open_pr" != yes ]]; then
  disputes=$(ai_helper disputes-verify) || stop 'pull request preparation'
  disputed=''
  if (( disputes > 0 )); then disputed=" and resolve $disputes disputed finding(s) (.ai/reviews/disputes.md)"; fi
  ai_notify "🏁 FINISHED on $branch: all tasks done, validated and reviewed ($reviews review round(s)); no PR requested. Your todo: review the branch locally$disputed."
  printf '%s\n' 'Pipeline complete (no PR requested).'
  finish
fi
step pr 'Pull request'
# Draft reasons: the human's --draft (never recorded) or the pipeline's policy (unresolved
# findings, disputes). Only a PR the pipeline drafted for policy is made ready again later;
# that ownership lives in host state (pr-draft), which agent sessions cannot forge.
human_draft=no
if [[ "$draft" == yes ]]; then
  human_draft=yes
  # The human's explicit draft revokes pipeline ownership, before any gh change: a record that
  # cannot be removed stops the run (it would un-draft the PR in a later run).
  if ! why=$(ai_helper pr-draft clear 2>&1 >/dev/null); then
    printf 'could not revoke the pipeline draft record: %s; delete that file, then rerun ai-pipeline --draft\n' \
      "${why#Error: }" > .ai/local/last-error
    stop 'pull request'
  fi
fi
if ! git remote get-url origin >/dev/null 2>&1; then
  ai_notify "🏁 FINISHED on $branch (local only): no 'origin' remote to open a PR on. Your todo: push and open a PR."
  printf '%s\n' "No 'origin' remote; branch is ready locally."
  finish 'no PR (local only)'
fi
push push 'git push failed (3 tries)' -u origin "$branch"
if ! command -v gh >/dev/null; then
  ai_notify "🏁 FINISHED on $branch: pushed, but gh is not installed. Your todo: open the PR yourself."
  finish 'pushed, no PR (gh missing)'
fi
title=$(ai_helper pr-title)
# The handoff's Flow chart line, once per run (key `final`, often already claimed by ai-run's
# final gate); the handoff and its Ruling row land in the pull request record commit below.
ai_flow_line_ruling final none
body=$(mktemp .ai/local/pr-XXXXXXXX.md)
ai_helper pr-body "$reviews" "$unresolved" > "$body"
disputes=$(ai_helper disputes-verify) || stop 'pull request'
policy_draft=no
# A recorded dispute keeps the PR a draft for good; only the human resolves it.
if [[ "$unresolved" == 1 || "$disputes" != 0 ]]; then policy_draft=yes; fi
make_draft=no
if [[ "$human_draft" == yes || "$policy_draft" == yes ]]; then make_draft=yes; fi
pipeline_drafted=no
if [[ "$policy_draft" == yes && "$human_draft" == no ]]; then pipeline_drafted=yes; fi
# Every gh call runs through ai_run_child or pub_read: a stop to this pid alone ends it.
if pub_read gh pr view "$branch" --json url --jq .url 2>/dev/null && url=$pub_text && [[ -n "$url" ]]; then
  ai_run_child gh pr edit "$branch" --body-file "$body" >/dev/null || { printf '%s\n' 'gh pr edit failed' > .ai/local/last-error; stop 'pull request'; }
  pub_read gh pr view "$branch" --json isDraft --jq .isDraft 2>/dev/null || true
  is_draft=$pub_text
  if [[ "$make_draft" == yes && "$is_draft" != true ]]; then
    # Never leave an existing ready PR "ready" when the policy says draft.
    ai_run_child gh pr ready --undo "$branch" >/dev/null 2>&1 && \
      { pub_read gh pr view "$branch" --json isDraft --jq .isDraft 2>/dev/null || true; [[ "$pub_text" == true ]]; } || \
      { printf '%s\n' 'could not convert the existing PR to draft' > .ai/local/last-error; stop 'pull request'; }
    # Ownership only from a confirmed ready PR: an unknown prior state (failed lookup) may have
    # been a human draft, so it never counts as a pipeline draft.
    if [[ "$pipeline_drafted" == yes && "$is_draft" == false ]]; then
      ai_helper pr-draft record "$url" converted || printf '%s\n' 'Warning: could not record the pipeline draft; a later clean run leaves the PR draft.'
    elif [[ "$pipeline_drafted" == yes ]]; then
      printf '%s\n' 'Note: the PR draft state was unknown before; not recorded as a pipeline draft, so a later clean run leaves it draft.'
    fi
  elif [[ "$make_draft" == no && "$is_draft" == true ]]; then
    # Ready again only when the pipeline drafted it itself: the record is consumed first, so
    # a record that cannot be removed never un-drafts (a human re-draft between runs is not seen).
    if how=$(ai_helper pr-draft take "$url" 2>/dev/null); then
      if ai_run_child gh pr ready "$branch" >/dev/null 2>&1 && \
         { pub_read gh pr view "$branch" --json isDraft --jq .isDraft 2>/dev/null || true; [[ "$pub_text" == false ]]; }; then
        printf '%s\n' 'Marked the PR ready (the pipeline had made it a draft).'
        ai_log none "pull request marked ready: $url" PASS 'drafted by the pipeline earlier'
      else
        printf '%s\n' 'Warning: could not mark the PR ready; it stays a draft.'
        # Best effort: a lost record only leaves the PR draft (fails closed).
        ai_helper pr-draft record "$url" "$how" >/dev/null 2>&1 || true
      fi
    elif [[ "$(ai_helper pr-draft get 2>/dev/null)" == "$url" ]]; then
      printf '%s\n' 'Warning: could not consume the pipeline draft record; PR left as draft.'
    else
      printf '%s\n' 'PR is a draft set outside the pipeline; left as draft.'
    fi
  elif [[ "$make_draft" == no && "$is_draft" == false ]]; then
    # A ready PR: any record is stale (a human made it ready). Never un-drafts anything.
    ai_helper pr-draft clear >/dev/null 2>&1 || printf '%s\n' 'Warning: could not clear a stale pipeline draft record.'
  fi
else
  pr_args=(--title "$title" --body-file "$body" --base "$pr_base")
  if [[ "$make_draft" == yes ]]; then pr_args+=(--draft); fi
  pub_capture gh pr create --head "$branch" "${pr_args[@]}" && url=$(tail -n 1 -- "$pub_out") || { printf '%s\n' 'gh pr create failed' > .ai/local/last-error; stop 'pull request'; }
  if [[ "$pipeline_drafted" == yes ]]; then
    ai_helper pr-draft record "$url" created || printf '%s\n' 'Warning: could not record the pipeline draft; a later clean run leaves the PR draft.'
  fi
fi
ai_helper state ready_for_acceptance "Human: test and merge the pull request $url"
ai_log none "pull request ready: $url" PASS 'Human acceptance and merge remain'
host_commit 'chore(ai): record pull request' .ai/state.md .ai/run-log.md .ai/handoff.md
push 'final push' "PR is open at $url, but pushing the final handoff commit failed" origin "$branch"
ai_notify "$(ai_helper finish-summary "$url" "$reviews" "$unresolved" 2>/dev/null || printf '🏁 FINISHED: PR %s' "$url")"
printf 'Pull request: %s\n' "$url"
finish "$url"
