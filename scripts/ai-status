#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  cat <<'USAGE'
Usage: ai-status                      workflow state of this checkout
       ai-status --outcomes [FILE...]  task/review outcomes per model, category and reviewer
                                       (default: the host outcome log of all projects,
                                       $AI_STATE_DIR/outcomes.jsonl)
       ai-status --catch-up-done BRANCH...
                                       record that Codex caught up on BRANCH's Claude-only
                                       reviews (they leave "Codex catch-up pending")
USAGE
  exit 0
fi
if [[ "${1:-}" == --catch-up-done ]]; then
  shift
  [[ $# -gt 0 ]] || { echo "Usage: ai-status --catch-up-done BRANCH..." >&2; exit 2; }
  ai_root
  for branch in "$@"; do
    ai_helper outcome catchup "$branch"
    echo "Recorded Codex catch-up for $branch"
  done
  exit 0
fi
if [[ "${1:-}" == --outcomes ]]; then
  shift
  ai_helper outcomes-report "$@"
  exit 0
fi
ai_root
ai_helper status
