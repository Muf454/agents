#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  cat <<'EOF'
Usage: ai-review --base REF [--timeout SECONDS]   review the implementation
       ai-review --plan [--timeout SECONDS]       review spec/plan/tasks before implementing
       ai-review --recheck [--timeout SECONDS]    Codex re-checks the BLOCKER/MAJOR findings
                                                  Claude rejected (withdrawn or upheld each)
Model/effort: AI_REVIEW_MODEL (default: Codex default), AI_REVIEW_EFFORT (default high);
the re-check uses AI_RECHECK_EFFORT (default medium).
EOF
  exit 0
fi
base=''; limit=1800; plan=no; recheck=no
while (( $# )); do
  case "$1" in
    --plan) plan=yes; shift ;;
    --recheck) recheck=yes; shift ;;
    --base) (( $# >= 2 )) || ai_die 'Missing base'; base=$2; shift 2 ;;
    --timeout)
      (( $# >= 2 )) || ai_die 'Missing timeout'
      [[ "$2" =~ ^[1-9][0-9]*$ && ${#2} -le 7 ]] || ai_die 'Invalid timeout'
      limit=$2; shift 2 ;;
    *) ai_die "Unknown argument: $1" ;;
  esac
done
[[ "$plan$recheck" != yesyes ]] || ai_die 'Choose --plan or --recheck, not both.'
if [[ "$plan" == no && "$recheck" == no ]]; then
  [[ -n "$base" && "$base" != -* ]] || ai_die 'Supply --base REF (e.g. main or a saved starting commit).'
fi
command -v codex >/dev/null || ai_die 'Install and authenticate Codex CLI first.'
if [[ "$recheck" == yes ]]; then ai_review_args AI_RECHECK_EFFORT medium; else ai_review_args; fi
ai_root
ai_lock

# Codex read-only run with usage-limit pauses. Sets $report; $1 is the prompt.
codex_review() {
  local prompt=$1 code reset start_head
  start_head=$(git rev-parse HEAD)
  report=$(mktemp .ai/local/review-XXXXXXXX.md)
  events="${report%.md}.events.log"
  while true; do
    set +e
    timeout --signal=TERM --kill-after=10s "$limit" codex exec \
      --ignore-user-config -c 'approval_policy="never"' --sandbox read-only "${AI_REVIEW_ARGS[@]}" \
      --output-last-message "$report" "$prompt" < /dev/null > "$events" 2>&1
    code=$?
    set -e
    (( code != 0 )) || break
    if (( code != 124 && code != 137 )) && reset=$(ai_helper limit-check "$events"); then
      ai_limit_pause Codex "$reset"
      [[ "$(git rev-parse HEAD)" == "$start_head" && -z "$(git status --porcelain --untracked-files=all)" ]] || \
        ai_die 'Checkout changed while waiting for the Codex limit; rerun the review.'
      continue
    fi
    ai_die "Codex failed; prior review preserved. See $events."
  done
  [[ -s "$report" ]] || ai_die "Codex produced no review; see $events."
  [[ "$(git rev-parse HEAD)" == "$start_head" && -z "$(git status --porcelain --untracked-files=all)" ]] || \
    ai_die 'Checkout changed during review; report kept locally, not published as current.'
}

if [[ "$plan" == yes ]]; then
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || ai_die 'Commit the plan before reviewing it.'
  ai_helper tasks check
  [[ -f .ai/prompts/plan-review.md ]] || ai_die 'Missing .ai/prompts/plan-review.md; copy it from the toolkit templates.'
  digest=$(ai_helper plan-digest)
  prompt=$(cat .ai/prompts/plan-review.md)
  prompt+=$'\n\nPLAN SCOPE: HEAD='
  prompt+="$(git rev-parse HEAD). Return the full Markdown plan review as the final response. Do not write project files or invoke network/MCP integrations."
  codex_review "$prompt"
  ai_helper publish-plan-review "$report" "$digest"
  # Run by hand, record it like the pipeline does, so the checkout stays clean for ai-pipeline.
  if [[ -z "${AI_PIPELINE:-}" ]]; then
    git add -- .ai/reviews/plan.md
    git diff --cached --quiet -- .ai/reviews/plan.md || \
      git commit -q -m 'chore(ai): record plan review' -- .ai/reviews/plan.md
    # A commit hook that changed reviewed content would make the verdict stale.
    [[ "$(ai_helper plan-review-info)" == current* && -z "$(git status --porcelain --untracked-files=all)" ]] || \
      ai_die 'Reviewed content changed while recording the plan review (commit hook?); review again.'
  fi
  read -r _ blockers majors minors < <(ai_helper plan-review-info)
  printf 'Plan review saved to .ai/reviews/plan.md: BLOCKER %s, MAJOR %s, MINOR %s.\n' "$blockers" "$majors" "$minors"
  exit 0
fi
if [[ "$recheck" == yes ]]; then
  # Own preflight: a verified review, the reviewed code unchanged except workflow records
  # (pending accepted fix tasks are fine) and at least one rejected BLOCKER/MAJOR.
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || ai_die 'Commit the triage before the re-check.'
  [[ -f .ai/prompts/recheck.md ]] || ai_die 'Missing .ai/prompts/recheck.md; copy it from the toolkit templates.'
  prepared=$(ai_helper recheck-prepare) || ai_die 'Re-check preflight failed (see above).'
  read -r head digest rows_hash <<< "${prepared%%$'\n'*}"
  prompt=$(cat .ai/prompts/recheck.md)
  prompt+=$'\n\nRECHECK SCOPE: reviewed HEAD='
  prompt+="$head; review: .ai/reviews/current.md; dispositions: .ai/reviews/dispositions.md. Rejected findings (ID, level, Claude's evidence), one per line:"
  prompt+=$'\n'"${prepared#*$'\n'}"
  prompt+=$'\n\nReturn only the JSON object as the final response. Do not write project files or invoke network/MCP integrations.'
  codex_review "$prompt"
  ai_helper publish-recheck "$report" "$head" "$digest" "$rows_hash"
  # Run by hand, record it like the plan review, so the checkout stays clean.
  if [[ -z "${AI_PIPELINE:-}" ]]; then
    git add -- .ai/reviews/recheck.md
    git diff --cached --quiet -- .ai/reviews/recheck.md || \
      git commit -q -m 'chore(ai): record review re-check' -- .ai/reviews/recheck.md
  fi
  answers=$(ai_helper recheck-verify) || ai_die 'Re-check report failed verification after saving it (commit hook?).'
  upheld=$(grep -c $'\tupheld\t' <<< "$answers" || true)
  withdrawn=$(grep -c $'\twithdrawn\t' <<< "$answers" || true)
  printf 'Re-check saved to .ai/reviews/recheck.md: %s withdrawn, %s upheld.\n' "$withdrawn" "$upheld"
  exit 0
fi
exec 8>.ai/local/validation.lock
flock -n 8 || ai_die 'Validation is running; finish it before review.'
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || ai_die 'Checkpoint all work before review.'
ai_helper tasks check
ai_helper tasks complete || ai_die 'Complete the task queue before final review.'
ai_helper stamp verify
base_sha=$(git rev-parse --verify "${base}^{commit}") || ai_die 'Invalid review base.'
merge_base=$(git merge-base "$base_sha" HEAD) || ai_die 'Base has no shared history with HEAD.'
head=$(git rev-parse HEAD)
[[ "$merge_base" != "$head" ]] || ai_die 'Empty review range. Choose the pre-implementation base.'
prompt=$(cat .ai/prompts/review.md)
prompt+=$'\n\nREVIEW SCOPE: HEAD='
prompt+="$head; supplied base=$base_sha; merge-base=$merge_base. Inspect git diff $merge_base..$head and actual source. Validation evidence: .ai/local/validation.json. Return the full Markdown review as the final response. Do not write project files or invoke network/MCP integrations."
# Earlier rounds are context for Codex, never authority; a helper failure must not block the review.
if history=$(ai_helper review-history --base "$merge_base" --head "$head" 2>&1); then
  if [[ -n "$history" ]]; then
    prompt+=$'\n\nPREVIOUS ROUNDS:\n'"$history"
    last_head=$(ai_helper review-history --base "$merge_base" --head "$head" --last-head 2>/dev/null || true)
    if [[ -n "$last_head" ]] && git merge-base --is-ancestor "$last_head" "$head" 2>/dev/null; then
      prompt+=$'\n\nCHANGED SINCE THE LAST REVIEW: inspect git diff '"$last_head..$head"
    fi
  fi
else
  printf 'Warning: review-history failed; reviewing without earlier rounds: %s\n' "$history" >&2
fi
codex_review "$prompt"
ai_helper publish-review "$report" "$head" "$merge_base"
read -r _ blockers majors minors < <(ai_helper review-info)
printf 'Review saved to .ai/reviews/current.md (HEAD %s): BLOCKER %s, MAJOR %s, MINOR %s. Claude evaluates findings before fixing.\n' \
  "$head" "$blockers" "$majors" "$minors"
[[ -n "${AI_PIPELINE:-}" ]] || ai_notify "Codex review done: BLOCKER $blockers, MAJOR $majors, MINOR $minors."
