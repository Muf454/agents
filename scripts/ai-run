#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
usage() {
  cat <<'EOF'
Usage: ai-run --approved [--sessions N] [--session-timeout SECONDS] [--run-timeout SECONDS]
              [--model NAME] [--knowledge-dir DIRECTORY] [--triage [--since COMMIT]]
              [--revise-plan [--since COMMIT] [--base REF]]
       ai-run --plan PROMPT_FILE [--revision] [--model NAME] [--session-timeout SECONDS]
              [--knowledge-dir DIRECTORY] [--read-dir DIRECTORY]...
Run Claude on the approved plan, one recoverable task per fresh session.
Defaults: sessions = unfinished tasks + 2 (at least 16; recomputed on every call, so fix-round
tasks are covered), 1800 seconds/session (an implementation session also gets twice the
measured gate time, at most another session_timeout), 14400 seconds/run. Rerun to resume.
--model sets the Claude model (default: AI_MODEL or the CLI default); a task's
optional "Model:" line overrides it. --triage runs one session that evaluates the
current Codex review and turns accepted findings into new tasks (no implementation),
then records the round in one "chore(ai): record review triage" commit. When the
dispositions are already complete (an interrupted triage), it records the round
without a new session. --since (ai-pipeline's stage start) bounds what triage may
have changed: only workflow records, committed or not.
--revise-plan answers the current plan review (.ai/reviews/plan.md, BLOCKER+MAJOR > 0, no
task DONE) in one Claude session (default model opus) that may only read and Edit the plan
records: one row per finding in the round's section of .ai/reviews/plan-dispositions.md
(accepted with new TODO tasks, rejected with evidence, or needs-human with a question).
The host validates the section, then records it in one "chore(ai): record plan revision"
commit (its run-log line included) and a host record; a complete but uncommitted section is
recorded without a session, and a plan review that was already revised is refused. --base
(default main) is where plan-review rounds start. A needs-human row stops supervision until
you answer it, commit, and run ai-review --plan again (a new report clears the decision).
--plan writes the plan in one headless Claude session (default model opus, default limit
3600 seconds; the watchdog's "hung" warning may still fire after 45 quiet minutes) from the
objective in PROMPT_FILE (a regular file, at most 200 KB). The session may only read and
Edit/Write .ai/project-spec.md, current-plan.md, tasks.md, state.md, handoff.md and
reviews/dispositions.md (no shell; no project allowlist, so --approved is not needed). The host
then checks the scope and the task queue, shows the stage on ai-dashboard and leaves the plan
uncommitted for you to review. --revision says an earlier plan exists (keep DONE tasks).
--read-dir (repeatable, --plan only) gives the session read-only access to an existing reference
directory (plans, research); --knowledge-dir stays the knowledge base option.
--plan runs outside ai-pipeline and refuses --triage, --revise-plan, --since, --base,
--sessions and --run-timeout.
Usage-limit errors pause until the reset (AI_LIMIT_RETRY/AI_LIMIT_MAX_WAIT) and resume. Inside
ai-pipeline, a reset beyond that budget is relaunched after the reset by the watchdog timer (--recover),
at most AI_LIMIT_RELAUNCH_MAX (default 2) times per run.
A task blocked although its session's own gate run showed no failing check gets one more session,
once per task per run, when the host's full gate then passes on the same tree.
Before a task runs, the host runs .ai/ci-setup when dependencies are missing or stale
(time limit AI_DEPS_TIMEOUT, default 1200 seconds; log in .ai/local/deps-*.log).
The human must inspect the plan, validation script, and permission allowlist first.
EOF
}
sessions=''; sessions_given=no; session_timeout=1800; run_timeout=14400; approved=no; knowledge_dir=''
model=${AI_MODEL:-}; triage=no; since=''; revise_plan=no; base=''; explicit_model=''
plan_file=''; plan_revision=no; session_timeout_given=no; run_timeout_given=no; read_dirs=()
while (( $# )); do
  case "$1" in
    --approved) approved=yes; shift ;;
    --plan)
      (( $# >= 2 )) && [[ -n "$2" ]] || ai_die 'Missing --plan PROMPT_FILE'
      # Resolved now: ai_root changes to the checkout root before the prompt is read.
      [[ -f "$2" && -r "$2" ]] || ai_die "Prompt file not found or unreadable: $2"
      (( $(stat -c %s -- "$2") <= 204800 )) || ai_die "Prompt file is larger than 200 KB: $2"
      plan_file=$(cd -- "$(dirname -- "$2")" && pwd -P)/$(basename -- "$2")
      shift 2 ;;
    --revision) plan_revision=yes; shift ;;
    --triage) triage=yes; shift ;;
    --revise-plan) revise_plan=yes; shift ;;
    --since)
      (( $# >= 2 )) && [[ "$2" =~ ^[0-9a-f]{40}$ ]] || ai_die 'Missing or invalid --since commit'
      since=$2; shift 2 ;;
    --base)
      (( $# >= 2 )) && [[ -n "$2" && "$2" != -* ]] || ai_die 'Missing or invalid --base REF'
      base=$2; shift 2 ;;
    --model)
      (( $# >= 2 )) || ai_die 'Missing model name'
      model_pattern='^[][A-Za-z0-9._:-]{1,64}$'
      [[ "$2" =~ $model_pattern ]] || ai_die "Invalid model name: $2"
      model=$2; explicit_model=$2; shift 2 ;;
    --knowledge-dir)
      (( $# >= 2 )) || ai_die 'Missing knowledge directory'
      [[ -d "$2" ]] || ai_die 'Knowledge directory must already exist.'
      knowledge_dir=$(cd -- "$2" && pwd -P)
      shift 2 ;;
    --read-dir)
      (( $# >= 2 )) && [[ -n "$2" ]] || ai_die 'Missing --read-dir DIRECTORY'
      [[ -d "$2" ]] || ai_die "Read directory not found: $2"
      read_dir=$(cd -- "$2" && pwd -P) || ai_die "Read directory not found: $2"
      # Glob and list characters would widen or split the Read(...) allow entry.
      [[ "$read_dir" != *[]*?[\(\),$'\n']* ]] || ai_die "Invalid --read-dir path: $read_dir"
      read_dirs+=("$read_dir")
      shift 2 ;;
    --sessions|--session-timeout|--run-timeout)
      (( $# >= 2 )) || ai_die "Missing value for $1"
      [[ "$2" =~ ^[1-9][0-9]*$ && ${#2} -le 7 ]] || ai_die "Invalid limit: $2"
      case "$1" in
        --sessions) sessions=$2; sessions_given=yes ;;
        --session-timeout) session_timeout=$2; session_timeout_given=yes ;;
        --run-timeout) run_timeout=$2; run_timeout_given=yes ;;
      esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; ai_die "Unknown argument: $1" ;;
  esac
done
[[ "$plan_revision" == no || -n "$plan_file" ]] || ai_die '--revision only applies to --plan.'
(( ${#read_dirs[@]} == 0 )) || [[ -n "$plan_file" ]] || ai_die '--read-dir only applies to --plan.'
if [[ -n "$plan_file" ]]; then
  # Refusals use the "given" flags, never the values, so a default can never slip through.
  [[ -z "${AI_PIPELINE:-}" ]] || ai_die 'ai-run --plan runs outside a pipeline.'
  for refused in "--triage:$triage" "--revise-plan:$revise_plan" "--since:${since:+yes}" \
      "--base:${base:+yes}" "--sessions:$sessions_given" "--run-timeout:$run_timeout_given"; do
    [[ "${refused#*:}" != yes ]] || ai_die "${refused%%:*} does not apply to --plan."
  done
  # An opus first plan on a real repository can take longer than a task session.
  [[ "$session_timeout_given" == yes ]] || session_timeout=3600
fi
[[ "$approved" == yes || -n "$plan_file" ]] || ai_die 'Review the plan/permissions/checks, then pass --approved.'
[[ "$triage" == no || "$revise_plan" == no ]] || ai_die '--triage and --revise-plan are exclusive.'
[[ -z "$since" || "$triage" == yes || "$revise_plan" == yes ]] || \
  ai_die '--since only applies to --triage and --revise-plan.'
[[ -z "$base" || "$revise_plan" == yes ]] || ai_die '--base only applies to --revise-plan.'
ai_supervise_settings
command -v claude >/dev/null || ai_die 'Install and authenticate Claude Code first.'
ai_root
# Host authority state must live where agent sessions cannot write (also for --triage).
state_error=$(ai_helper state-root-check ${knowledge_dir:+"$knowledge_dir"} 2>&1) || \
  ai_die "${state_error#Error: }"
ai_lock
rm -f .ai/local/last-error
AI_START_BRANCH=$(git symbolic-ref --quiet --short HEAD) || ai_die 'Detached HEAD.'
ai_branch
git rev-parse --verify HEAD >/dev/null 2>&1 || ai_die 'Create an initial Git commit first.'
# A planning session may only touch the plan records (committed or not); its error already
# starts with "Planning" unless git itself failed.
plan_scope() {
  local error
  error=$(ai_helper plan-scope "$1" 2>&1) || {
    error=${error#Error: }
    [[ "$error" == Planning* ]] || error="Planning: $error"
    ai_die "$error"
  }
}
# `clean_or_armed` (lib/common.sh) admits the armed tree below; AI_ARMED=yes then means the
# consumer owes the preserved work its route, and stays yes until the consumer's disarm.
# A task attempt whose runner was killed (SIGKILL, no exit handler) left its marker; log it as
# `crashed` once, before the clean-checkpoint refusal below: `ai_helper state implementing`
# dirties tracked .ai/state.md before every session, so a killed runner always leaves a dirty
# checkout and the restart refuses before anything later could run. Best effort, host state
# only, and the same checkout helper state-root-check already ran before the baseline, so it
# adds no new trust class. Triage and plan revision never open attempts but may reconcile.
attempt_dir=
attempt_id=
if [[ -z "$plan_file" ]]; then
  attempt_dir=$(ai_helper outcome attempt-dir 2>/dev/null) || attempt_dir=
  ai_helper outcome attempt-reconcile "$$" || true
fi
if [[ -n "$plan_file" ]]; then
  # A first plan starts from the template queue, so the queue is checked after the session;
  # the START and working-tree queues are parsed here so a malformed heading stops before a
  # session is spent.
  plan_scope HEAD
  keep_error=$(ai_helper plan-keeps-done HEAD --baseline .ai/tasks.md 2>&1 >/dev/null) || \
    ai_die "Planning: ${keep_error#Error: }"
else
  # Triage and plan revision check their own leftovers below (an interrupted one may leave
  # workflow records). The usage-limit relaunch's resume may start from exactly the preserved
  # task work it armed (consumed once, below, before the first act).
  if [[ "$triage" == no && "$revise_plan" == no ]] && ! clean_or_armed; then
    ai_die 'Start from a clean checkpoint. Reconcile/commit interrupted changes first.'
  fi
  # An interrupted revision's uncommitted queue is repaired as its session's would have been
  # (the helper decides; a committed or non-revision queue is left to the checks).
  if [[ "$revise_plan" == yes ]]; then
    repair_out=$(ai_helper revision-queue-repair 2>&1) || \
      ai_die "Plan revision stage: task queue is invalid: ${repair_out#Error: }"
    [[ -z "$repair_out" ]] || printf '%s\n' "$repair_out"
  fi
  ai_helper tasks check
fi
# Authoritative baseline stays in shell memory, not an agent-editable file.
AI_APPROVED_GATE=$(ai_guard_digest) || ai_die 'Cannot approve missing/unsafe workflow gate.'
readonly AI_APPROVED_GATE
printf 'Approved workflow gate SHA-256: %s\n' "$AI_APPROVED_GATE"
printf '%s\n' "$AI_APPROVED_GATE" > .ai/local/approved-gate.sha256
knowledge_args=()
if [[ -n "$knowledge_dir" ]]; then knowledge_args=(--add-dir "$knowledge_dir"); fi
allowed=()
if [[ -z "$plan_file" ]]; then
  mapfile -t allowed < <(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' .ai/permissions.allow)
  (( ${#allowed[@]} )) || ai_die 'Empty permission allowlist.'
fi
all_tools=Read,Glob,Grep,Edit,Write,Bash
started=$SECONDS
active_task=none
finished=no
# A task attempt is open from the moment its implementation session starts until its outcome is
# logged; any stop in between (session error, timeout, interruption, a limit wait beyond the
# budget, a malformed queue) logs exactly one outcome. Triage never tracks an attempt.
track_attempt=no
attempt_open=no
session_code=
on_exit() {
  local code=$?
  [[ -z "${plan_baseline:-}" ]] || rm -f -- "$plan_baseline"
  # Never run a project helper after the approved gate changed: a stop for that reason logs
  # nothing (the check also sets AI_GATE_BROKEN, so the notification skips its log helper).
  local gate_ok=no; if ai_gate_check "$AI_APPROVED_GATE"; then gate_ok=yes; fi
  if [[ "$attempt_open" == yes && "$gate_ok" == yes ]]; then
    if (( code == 130|| code == 143 )); then task_outcome interrupted
    elif [[ "$session_code" == 124 || "$session_code" == 137 ]]; then task_outcome timeout
    else task_outcome error
    fi
  elif [[ "$attempt_open" == yes ]]; then
    # A deliberate no-log stop must not be reported as a crash at the next start: remove only
    # this attempt's marker (no helper may run); other retained markers stay for that start.
    [[ -z "$attempt_dir" || -z "$attempt_id" ]] || rm -f -- "$attempt_dir/$attempt_id.json"
  fi
  if [[ "$finished" != yes ]]; then
    if [[ "$active_task" == planning && "$gate_ok" == yes ]]; then
      plan_result=stopped
      if (( code == 130 || code == 143 )); then plan_result=interrupted
      elif [[ "$session_code" == 124 || "$session_code" == 137 ]]; then plan_result=timeout
      fi
      ai_helper outcome plan "$plan_result" "${plan_model:-opus}" "$(( ${plan_started:+SECONDS - plan_started} + 0 ))" \
        $([[ "${plan_revision:-}" != yes ]] || printf -- '--revision') 2>/dev/null || true
      ai_observe stop plan "$(head -n 1 .ai/local/last-error 2>/dev/null || echo "exit $code")"
    fi
    if [[ -n "${revision_started:-}" && "$gate_ok" == yes ]]; then
      ai_helper outcome plan_revision "$revision_round" stopped "$revision_model" "$(( SECONDS - revision_started ))" \
        2>/dev/null || true
    fi
    # No host write while armed: the preserved tree stays exactly the armed one.
    [[ "$AI_ARMED" == yes ]] || ai_log "$active_task" "stopped (exit $code); inspect state/diff before resuming" \
      'see local logs' 'No merge or deployment performed'
    # Inside ai-pipeline the pipeline reports the stop itself.
    [[ -n "${AI_PIPELINE:-}" ]] || \
      ai_notify "⛔ STOPPED, needs you: runner stopped at $active_task: $(cat .ai/local/last-error 2>/dev/null || echo "exit $code")"
    [[ -n "${AI_PIPELINE:-}" ]] || touch .ai/local/last-error.notified 2>/dev/null || true
  fi
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The runner owns the bookkeeping records and commits leftovers in them; anything
# else left uncommitted means the session didn't checkpoint its work.
dirty_beyond_records() {
  git status --porcelain --untracked-files=all -- . ':!.ai/state.md' ':!.ai/run-log.md' ':!.ai/handoff.md'
}

# Host-side outcome log for tuning the model rules (ai-status --outcomes); never fatal.
task_outcome() {
  local attempt_args=()
  if [[ -n "$attempt_id" ]]; then attempt_args=(--attempt "$attempt_id"); fi
  attempt_open=no
  ai_helper outcome task "$active_task" "$1" "${task_model:-$model}" "$(( SECONDS - task_started ))" \
    "${attempt_args[@]}" 2>/dev/null || printf '%s\n' 'Note: could not append to the outcome log.' >&2
  attempt_id=
}

# Host gate run timing for the implementation session allowance (gate-seconds); never fatal.
# Call only after ai_guard_verify: the gate may have changed. Usage: record_gate CODE STARTED.
record_gate() {
  local result=fail
  if (( $1 == 0 )); then result=pass; elif (( $1 == 124 || $1 == 137 )); then result=timeout; fi
  ai_helper outcome gate "$result" "$(( SECONDS - $2 ))" 2>/dev/null || \
    printf '%s\n' 'Note: could not record the gate time.' >&2
}

# Sessions keep throwaway files in .ai/local/scratch; emptied before and after each session
# through pinned descriptors (never follows a symlink there). A failure only warns.
clear_scratch() { ai_helper clear-scratch || true; }

review_digest() { sha256sum .ai/reviews/current.md 2>/dev/null | cut -d' ' -f1 || true; }

# An accepted checkpoint must hold exactly the bytes validation hashed (filters, hooks).
# The helper compares EVERY tracked file, so call this after the bookkeeping commit, when
# the workflow records are committed too. Stops without resetting anything.
verify_checkpoint() {
  local why
  if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
    why='uncommitted changes after the checkpoint'
  elif ! ai_helper stamp verify >/dev/null 2>&1; then
    why='validation stamp not current'
  elif ! why=$(ai_helper committed-matches-worktree 2>&1 >/dev/null); then
    why=${why#Error: }
  else
    return 0
  fi
  ai_die "The checkpoint of $1 differs from the validated content: $why"
}

remaining_time() { echo $(( run_timeout + AI_WAITED - (SECONDS - started) )); }

# The host's full gate; sets gate_code. A session may end with its own background gate still
# holding the validation lock (FL-32), so wait for it for up to 15 minutes within the run time.
host_gate() {
  local lock_wait=$remaining
  (( lock_wait <= 900 )) || lock_wait=900
  gate_code=0
  AI_CHECK_LOCK_WAIT=$lock_wait AI_CHECK_TIMEOUT=$remaining "$AI_BIN/ai-check" || gate_code=$?
}

knowledge_prompt() {
  [[ -n "$knowledge_dir" ]] || return 0
  printf '\nProject knowledge base explicitly configured for this run: %s. ' "$knowledge_dir"
  printf 'Read/update relevant architecture and decisions there; human todos require human confirmation. '
  printf 'Keep the operational queue/state/run log in .ai/ and Git. Do not relocate operational state to the knowledge base.\n'
}

# One fresh Claude session; a usage/rate-limit error pauses until the reset and retries.
# Usage: claude_session PROMPT MODEL TOOLS ALLOWED... (the --tools list and --allowedTools entries).
claude_session() {
  local prompt=$1 session_model=$2 tools=$3 limit code reset log errors remaining review_before restored
  local session_allowed=("${@:4}") model_args=() gate=0 allowance=0 breakdown=''
  if [[ -n "$session_model" ]]; then model_args=(--model "$session_model"); fi
  # An implementation session runs the gate itself: room for two measured gate runs, at most
  # another session_timeout (a corrupt log can at most double the limit). Kept across a limit retry.
  if [[ "$track_attempt" == yes ]]; then
    gate=$(ai_helper gate-seconds 2>/dev/null) || gate=0
    [[ "$gate" =~ ^[0-9]{1,7}$ ]] || gate=0
    allowance=$(( 2 * gate ))
    (( allowance <= session_timeout )) || allowance=$session_timeout
    (( allowance == 0 )) || breakdown=": ${session_timeout}s + ${allowance}s for two gate runs of ${gate}s"
  fi
  while true; do
    remaining=$(remaining_time)
    (( remaining > 0 )) || ai_die 'Run time limit reached; checkpoint and resume later.'
    limit=$(( session_timeout + allowance ))
    (( limit <= remaining )) || limit=$remaining
    log=$(mktemp .ai/local/claude-XXXXXXXX.json)
    errors="${log%.json}.stderr.log"
    review_before=$(review_digest)
    printf 'Session: %s%s (limit %ss%s; log %s)\n' "$active_task" \
      "${session_model:+ [model $session_model]}" "$limit" "$breakdown" "$log"
    if [[ "$track_attempt" == yes && "$attempt_open" == no ]]; then
      # After the preflight checks; a limit pause and retry stays inside this attempt.
      task_started=$SECONDS
      session_code=
      # The helper prints the id before it publishes the marker, so a marker can only exist
      # once this shell holds its id. Never clear a valid printed id because of the exit
      # status: a published marker would be left behind and the next start would log a
      # finished task as `crashed`.
      attempt_id=$(ai_helper outcome attempt-open "$active_task" "${task_model:-$model}" "$$" 2>/dev/null) || true
      [[ "$attempt_id" =~ ^[0-9a-f]{16}$ ]] || attempt_id=
      attempt_open=yes
    fi
    clear_scratch
    set +e
    timeout --signal=TERM --kill-after=10s "$limit" claude -p \
      --permission-mode dontAsk --output-format json \
      --tools "$tools" --allowedTools "${session_allowed[@]}" \
      --setting-sources project --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
      "${model_args[@]}" "${knowledge_args[@]}" \
      -- "$prompt" < /dev/null > "$log" 2> "$errors"
    code=$?
    set -e
    session_code=$code
    ai_guard_verify
    # Only now: the helper is the checkout's copy, trusted once the gate digest is verified.
    clear_scratch
    # The independent review is Codex's evidence; no Claude session may alter it.
    [[ "$(review_digest)" == "$review_before" ]] || \
      ai_die 'A Claude session modified .ai/reviews/current.md; inspect and restore the Codex report.'
    if (( code != 124 && code != 137 )) && ! ai_helper claude-result "$log" --check-only 2>/dev/null; then
      # Only a failed session is checked for limit messages (normal output may mention limits).
      if reset=$(ai_helper limit-check "$log" "$errors"); then
        ai_limit_pause Claude "$reset"
        continue
      fi
    fi
    if [[ "$track_attempt" == yes ]]; then
      ai_branch
      # A session cannot always chmod: give back the bit git records for a tracked script. Also
      # before a timeout or error stops the run, so ai-recover's rerun gate sees the bit.
      if ! restored=$(ai_helper exec-bits); then
        (( code == 0 )) || ai_die "Claude exited $code (timeout/interruption/error); also cannot restore recorded executable bits. Preserve partial work; see $log and $errors."
        ai_die 'Cannot restore recorded executable bits.'
      fi
      if [[ -n "$restored" ]]; then
        printf 'Restored the executable bit recorded in git: %s\n' "${restored//$'\n'/ }"
      fi
    fi
    (( code == 0 )) || ai_die "Claude exited $code (timeout/interruption/error). Preserve partial work; see $log and $errors."
    ai_helper claude-result "$log" || ai_die "Claude session failed or reported an error; see $log."
    return 0
  done
}

if [[ -n "$plan_file" ]]; then
  # A headless planning session: writes the plan records only, never commits, never implements.
  active_task=planning
  since=$(git rev-parse HEAD)
  plan_model=${explicit_model:-opus}
  plan_kind='first plan'
  if [[ "$plan_revision" == yes ]]; then plan_kind=revision; fi
  ai_helper pipeline-register "$AI_ROOT" "$AI_START_BRANCH" || \
    printf 'Warning: could not register this checkout for ai-dashboard.\n' >&2
  ai_observe step planning "$plan_model · $plan_kind"
  ai_notify "📝 PLANNING on $AI_START_BRANCH ($plan_model, $plan_kind)."
  prompt=''
  if [[ -f .ai/prompts/plan.md ]]; then prompt=$(cat .ai/prompts/plan.md)$'\n\n'; fi
  prompt+="OBJECTIVE (from $(basename -- "$plan_file")):"$'\n'"$(cat -- "$plan_file")"
  prompt+=$'\n\nPLANNING CONTRACT: Write the plan for the objective above. You may Edit/Write only '
  prompt+='.ai/project-spec.md, .ai/current-plan.md, .ai/tasks.md, .ai/state.md, .ai/handoff.md and '
  prompt+='.ai/reviews/dispositions.md. You have no shell. Do not commit and do not implement anything. '
  prompt+='After you finish, the host reorders .ai/tasks.md into dependency order (each task placed after '
  prompt+='the tasks it depends on; it rejects cycles, unknown IDs and prose in Dependencies:) and validates '
  prompt+='it with the same rules as .ai/bin/ai-task check: exactly one Status: and one Dependencies: line '
  prompt+='per task, and the required sections (the host adds a missing Likely affected modules or '
  prompt+='Result / notes to TODO tasks; anything else missing stops the run).'
  prompt+=' Keep every DONE task block exactly as it is (status, text and results); the host stops '
  prompt+='the run when a DONE task was changed or removed.'
  if [[ "$plan_revision" == yes ]]; then
    prompt+=' An earlier plan exists: keep DONE tasks, their status and results unchanged.'
  fi
  prompt+=$(knowledge_prompt)
  mapfile -t plan_allowed < <(ai_helper plan-allowlist)
  if (( ${#read_dirs[@]} )); then
    # Read access only: each directory joins the session (beside the knowledge base) with a
    # Read entry in Claude Code's absolute form (//abs/**); no Edit or Write entry is added.
    for read_dir in "${read_dirs[@]}"; do
      knowledge_args+=(--add-dir "$read_dir")
      plan_allowed+=("Read(/$read_dir/**)")
    done
    prompt+=$'\n\n'"Read-only reference directories: $(printf '%s, ' "${read_dirs[@]}")"
    prompt="${prompt%, }. Read them as needed; never edit them."
  fi
  # DONE tasks of the working-tree queue (committed or not) are protected too: the host keeps
  # its own copy outside the checkout, where the session cannot edit it (removed on exit).
  plan_baseline=$(mktemp "${TMPDIR:-/tmp}/ai-plan-queue.XXXXXXXX") || ai_die 'Planning: cannot copy the task queue.'
  if [[ -f .ai/tasks.md ]]; then cp -- .ai/tasks.md "$plan_baseline" || ai_die 'Planning: cannot copy the task queue.'
  else rm -f -- "$plan_baseline"
  fi
  plan_started=$SECONDS
  claude_session "$prompt" "$plan_model" Read,Glob,Grep,Edit,Write "${plan_allowed[@]}"
  ai_branch
  plan_scope "$since"
  keep_error=$(ai_helper plan-keeps-done "$since" --baseline "$plan_baseline" 2>&1 >/dev/null) || \
    ai_die "Planning: ${keep_error#Error: }"
  # Dependencies first; the reorder keeps every block's text, so DONE tasks stay as checked.
  fill_out=$(ai_helper tasks fill-sections 2>&1) || \
    ai_die "Planning: task queue is invalid: ${fill_out#Error: }"
  [[ -z "$fill_out" ]] || printf '%s\n' "$fill_out"
  reorder_out=$(ai_helper tasks reorder 2>&1) || \
    ai_die "Planning: task queue is invalid: ${reorder_out#Error: }"
  [[ -z "$reorder_out" ]] || printf '%s\n' "$reorder_out"
  queue_error=$(ai_helper tasks check 2>&1 >/dev/null) || \
    ai_die "Planning: task queue is invalid: ${queue_error#Error: }"
  read -r _ plan_total < <(ai_helper tasks counts) || ai_die 'Planning: cannot count the tasks.'
  ai_observe planned "$plan_total tasks"
  ai_helper outcome plan done "$plan_model" "$(( SECONDS - plan_started ))" "$plan_total" \
    $([[ "$plan_revision" != yes ]] || printf -- '--revision') || \
    printf 'Note: could not record the planning outcome.\n' >&2
  ai_log planning "plan written: $plan_total tasks ($plan_model, $plan_kind)" PASS 'Plan left uncommitted for review'
  ai_notify "📝 Plan ready on $AI_START_BRANCH: $plan_total tasks. Review and commit it, then start ai-pipeline --approved."
  finished=yes
  printf 'Plan ready on %s: %s tasks. Review and commit it, then start ai-pipeline --approved.\n' \
    "$AI_START_BRANCH" "$plan_total"
  exit 0
fi

if [[ "$revise_plan" == yes ]]; then
  # Answer the current plan review in the round's plan-dispositions section. No implementation.
  active_task=plan-revision
  [[ -f .ai/prompts/plan-revision.md ]] || \
    ai_die 'Missing .ai/prompts/plan-revision.md; install it with setup-project --upgrade.'
  ai_helper tasks untouched >/dev/null 2>&1 || \
    ai_die 'Plan revision: a task is already DONE; the plan review gate no longer applies.'
  plan_base=$(git merge-base "${base:-main}" HEAD 2>/dev/null) || \
    ai_die "Plan revision: invalid base ${base:-main} (pass --base REF)."
  info=$(ai_helper plan-review-info 2>&1) || ai_die "Plan revision: ${info#Error: }"
  read -r _ blockers majors _ <<< "$info"
  (( blockers + majors > 0 )) || ai_die 'Plan revision: the plan review has no BLOCKER or MAJOR finding.'
  ai_helper plan-rounds sync "$plan_base" || ai_die 'Plan revision: cannot read the host plan review records.'
  current=$(ai_helper plan-rounds current "$plan_base" 2>&1) || ai_die "Plan revision: ${current#Error: }"
  revision_round=${current%% *}
  set +e
  ai_helper plan-revisions revised 2>/dev/null
  revised=$?
  set -e
  (( revised != 0 )) || ai_die 'Plan revision: this plan review was already revised; review again (ai-review --plan).'
  (( revised == 1 )) || ai_die 'Plan revision: the host plan revision records are unreadable; inspect them.'
  since=${since:-$(git rev-parse HEAD)}
  # A revision may only touch plan records (committed or not), never source, tests, the gate or plan.md.
  revision_scope() {
    local error
    error=$(ai_helper plan-revision-scope "$since" 2>&1) || ai_die "${1}${error#Error: }"
  }
  revision_scope 'Plan revision stage: '
  plan_report=$(sha256sum .ai/reviews/plan.md | cut -d' ' -f1)
  check_args=(--since "$since" --base "$plan_base" --fresh)
  revision_model=${explicit_model:-opus}
  revision_started=$SECONDS
  [[ -n "${AI_PIPELINE:-}" ]] || ai_observe step plan_revision "round $revision_round · $revision_model"
  if ai_helper plan-dispositions-check "${check_args[@]}" >/dev/null 2>&1; then
    # An interrupted revision whose section is complete: record it, no new session.
    printf '%s\n' 'Plan dispositions are already complete; recording the revision.'
  else
    # Only the host's own section header may be left uncommitted (a crash before its commit).
    if [[ -n "$(dirty_beyond_records)" ]] && \
        { [[ -n "$(git status --porcelain --untracked-files=all -- . ':!.ai/state.md' ':!.ai/run-log.md' \
                   ':!.ai/handoff.md' ':!.ai/reviews/plan-dispositions.md')" ]] || \
          ! ai_helper start-plan-dispositions "$plan_base" --pending >/dev/null 2>&1; }; then
      ai_die 'Plan revision stage: incomplete plan revision records are uncommitted; inspect them before continuing.'
    fi
    # Host-written section bound to this round's report; Claude fills in the rows.
    ai_helper start-plan-dispositions "$plan_base"
    git add -- .ai/reviews/plan-dispositions.md
    git diff --cached --quiet || git commit -m 'chore(ai): open plan dispositions' >/dev/null
    ai_guard_verify
    # The session has no shell: the host prepares the git context it needs (ignored, removed after).
    context=.ai/local/revision-context
    rm -rf -- "$context"
    mkdir -p -- "$context"
    ai_helper plan-history "$plan_base" > "$context/plan-history.md" || \
      ai_die 'Plan revision stage: cannot summarise the earlier plan review rounds.'
    git log -p -n 20 --format='commit %H%n%s%n' "$plan_base..HEAD" -- .ai/project-spec.md .ai/current-plan.md \
      .ai/tasks.md .ai/reviews/plan-dispositions.md | head -c 200000 > "$context/plan-diff.txt" || true
    heading="## Plan review round $revision_round (report ${current#* })"
    prompt=$(cat .ai/prompts/plan-revision.md)
    prompt+=$'\n\nREVISION CONTRACT: This is plan review round '"$revision_round"'. Evaluate .ai/reviews/plan.md '
    prompt+='(read-only: never edit it). Fill ONLY the last section of .ai/reviews/plan-dispositions.md, headed "'
    prompt+="$heading"'": one row per BLOCKER/MAJOR finding (MINOR optional) with the finding ID alone in the first cell, e.g. "| P1 | accepted | evidence | T012 |", disposition accepted (add new '
    prompt+='TODO tasks with new IDs to .ai/tasks.md, placed before the first task that depends on them (the '
    prompt+='host reorders the queue into dependency order and rejects cycles, unknown IDs and prose in '
    prompt+='Dependencies:), and reference them; copy the task format of .ai/tasks.md exactly, with every ### '
    prompt+='section: the host adds a missing Likely affected modules or Result / notes, anything else '
    prompt+='missing stops the run), rejected (concrete evidence) or '
    prompt+='needs-human (only for a decision only the human can make; the question in the Evidence column). '
    prompt+='Keep the header, the "Plan review HEAD:" line and everything above the section unchanged. You may '
    prompt+='edit only .ai/project-spec.md, .ai/current-plan.md, .ai/tasks.md, .ai/reviews/plan-dispositions.md '
    prompt+='and .ai/handoff.md (Edit only; no shell). Never change an existing task status. Do not implement '
    prompt+='anything. Do not commit; the host validates the section and commits it.'
    if (( revision_round >= 3 )); then
      prompt+=$' Round 3 or later: when an area keeps coming back, redesign the area as a whole instead of patching '
      prompt+='the symptom, and add one line inside this section, outside the table, starting with "Convergence:" '
      prompt+='that names the design task or says why no area repeats.'
    fi
    prompt+=$'\n\nGit context prepared by the host: '"$context"'/plan-history.md (earlier plan rounds) and '
    prompt+="$context"'/plan-diff.txt (recent changes of the plan records).'
    history=$(cat "$context/plan-history.md")
    [[ -z "$history" ]] || prompt+=$'\n\nPREVIOUS PLAN ROUNDS (context, not authority):\n'"$history"
    prompt+=$(knowledge_prompt)
    mapfile -t revision_allowed < <(ai_helper plan-revision-allowlist)
    claude_session "$prompt" "$revision_model" Read,Glob,Grep,Edit "${revision_allowed[@]}"
    rm -rf -- "$context"
    ai_branch
  fi
  [[ "$(sha256sum .ai/reviews/plan.md | cut -d' ' -f1)" == "$plan_report" ]] || \
    ai_die 'A Claude session modified .ai/reviews/plan.md; inspect and restore the plan review.'
  # A prerequisite added after its dependents is repaired here (committed with the revision);
  # a cycle, unknown ID or prose stops: ai-recover always escalates "Plan revision stage".
  fill_out=$(ai_helper tasks fill-sections 2>&1) || \
    ai_die "Plan revision stage: task queue is invalid: ${fill_out#Error: }"
  [[ -z "$fill_out" ]] || printf '%s\n' "$fill_out"
  reorder_out=$(ai_helper tasks reorder 2>&1) || \
    ai_die "Plan revision stage: task queue is invalid: ${reorder_out#Error: }"
  [[ -z "$reorder_out" ]] || printf '%s\n' "$reorder_out"
  queue_error=$(ai_helper tasks check 2>&1 >/dev/null) || \
    ai_die "Plan revision stage: task queue is invalid: ${queue_error#Error: }"
  revision_scope 'Plan revision stage: '
  counts=$(ai_helper plan-dispositions-check "${check_args[@]}" 2>&1) || \
    ai_die "Plan revision incomplete: ${counts#Error: }"
  questions=$(ai_helper plan-dispositions-check "${check_args[@]}" --questions) || \
    ai_die 'Plan revision: cannot read the needs-human questions.'
  [[ "$counts" =~ ^accepted=([0-9]+)\ rejected=([0-9]+)\ needs_human=([0-9]+)$ ]] || \
    ai_die "Plan revision: unexpected counts: $counts"
  accepted=${BASH_REMATCH[1]} rejected=${BASH_REMATCH[2]} needs_human=${BASH_REMATCH[3]}
  # The log line and state go INTO the counted commit: nothing writes to the checkout after it,
  # so the following plan review starts from a clean checkout.
  ai_log plan-revision "plan revised (round $revision_round): accepted $accepted, rejected $rejected, needs-human $needs_human" \
    'n/a' 'Plan review runs again'
  if (( needs_human > 0 )); then
    ai_helper state blocked 'Plan review needs your decision: answer the needs-human rows in .ai/reviews/plan-dispositions.md, commit, run ai-review --plan'
  else
    ai_helper state planning 'Review the revised plan (ai-review --plan)'
  fi
  records=()
  for record in .ai/project-spec.md .ai/current-plan.md .ai/tasks.md .ai/reviews/plan-dispositions.md \
      .ai/handoff.md .ai/state.md .ai/run-log.md; do
    if [[ -e "$record" ]]; then records+=("$record"); fi
  done
  git add -- "${records[@]}"
  # Always the host's own commit: an agent commit's subject never counts.
  git commit --allow-empty -m 'chore(ai): record plan revision' >/dev/null
  ai_guard_verify
  printf '%s\n' "$questions" | ai_helper plan-revisions record "$plan_base" HEAD --accepted "$accepted" \
    --rejected "$rejected" --needs-human "$needs_human" || \
    ai_die 'Cannot record the plan revision in the host state directory.'
  # A commit hook must not have slipped anything else into the counted commit.
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
    ai_die 'Plan revision stage: changes were left after the revision commit (commit hook?).'
  revision_scope 'Plan revision stage: the revision commit is out of scope (commit hook?): '
  ai_helper outcome plan_revision "$revision_round" revised "$revision_model" "$(( SECONDS - revision_started ))" \
    2>/dev/null || printf '%s\n' 'Note: could not append to the outcome log.' >&2
  finished=yes
  printf 'Plan revision recorded (round %s): accepted %s, rejected %s, needs-human %s.\n' \
    "$revision_round" "$accepted" "$rejected" "$needs_human"
  [[ -z "$questions" ]] || printf 'Your decision is needed:\n%s\n' "$questions"
  exit 0
fi

if [[ "$triage" == yes ]]; then
  # Evaluate the current review into dispositions and new tasks. No implementation.
  [[ -f .ai/reviews/current.md ]] || ai_die 'No review to triage.'
  reviewed=$(ai_helper review-info) || ai_die 'Current review was not produced by ai-review.'
  active_task=triage
  [[ -n "${AI_PIPELINE:-}" ]] || ai_observe step triage
  since=${since:-$(git rev-parse HEAD)}
  # Triage may only touch workflow records (committed or not), never source, tests, or the gate.
  triage_scope() {
    local error
    error=$(ai_helper triage-scope "$since" 2>&1) || ai_die "${1}${error#Error: }"
  }
  triage_scope 'Triage stage: '
  if ai_helper triage-check --fresh >/dev/null 2>&1; then
    # An interrupted triage whose dispositions are complete: record the round, no new session.
    printf '%s\n' 'Triage dispositions are already complete; recording the round.'
  else
    [[ -z "$(dirty_beyond_records)" ]] || \
      ai_die 'Triage stage: incomplete triage records are uncommitted; inspect them before continuing.'
    # Host-written dispositions file bound to this review; Claude fills in the rows.
    ai_helper start-dispositions "${reviewed%% *}"
    git add -- .ai/reviews/dispositions.md
    # Resuming an interrupted triage finds the file already bound and committed.
    git diff --cached --quiet || git commit -m 'chore(ai): open review dispositions' >/dev/null
    ai_guard_verify
    prompt=$(cat .ai/prompts/triage.md)
    prompt+=$'\n\nTRIAGE CONTRACT: Evaluate .ai/reviews/current.md (read-only: never edit it). Add one row per BLOCKER/MAJOR finding (and MINOR where relevant) to .ai/reviews/dispositions.md, with the finding ID alone in the first cell, e.g. "| M1 | accepted | evidence | T012 |". Append new TODO tasks with new IDs for accepted findings and reference them. Copy the task format of .ai/tasks.md exactly: the heading, Status:, Dependencies:, Model: and every ### section (Goal, Implementation notes, Likely affected modules, Acceptance criteria, Validation, an empty Result / notes); the host adds a missing Likely affected modules or Result / notes, anything else missing stops the run. Do not implement fixes, change source/tests, or change the runner/permissions/validation policy. Commit the dispositions and task changes, then return.'
    # Same routine as triage-check --fresh, so the prompt and the check agree on the round.
    rounds=$(ai_helper review-history --current --count) || ai_die 'Triage stage: cannot count the earlier review rounds.'
    history=$(ai_helper review-history --current) || ai_die 'Triage stage: cannot summarise the earlier review rounds.'
    prompt+=$'\n\nThis review is round '"$(( rounds + 1 ))."
    [[ -z "$history" ]] || prompt+=$'\n\nPREVIOUS ROUNDS:\n'"$history"
    prompt+=$(knowledge_prompt)
    claude_session "$prompt" "$model" "$all_tools" "${allowed[@]}"
    ai_branch
    [[ -z "$(dirty_beyond_records)" ]] || \
      ai_die 'Triage left uncommitted changes; inspect and checkpoint before continuing.'
  fi
  # A new task that lacks Likely affected modules or Result / notes is repaired, not fatal.
  fill_out=$(ai_helper tasks fill-sections 2>&1) || \
    ai_die "Triage stage: task queue is invalid: ${fill_out#Error: }"
  [[ -z "$fill_out" ]] || printf '%s\n' "$fill_out"
  ai_helper tasks check
  triage_scope ''
  error=$(ai_helper triage-check --fresh 2>&1 >/dev/null) || ai_die "Triage incomplete: ${error#Error: }"
  ai_log triage 'review triaged into dispositions/tasks' 'n/a' 'Fix tasks run next'
  ai_helper state fixing_review 'Run the fix tasks, then review again'
  # The one counted commit of this round, including leftovers of an interrupted triage.
  records=()
  for record in .ai/tasks.md .ai/reviews/dispositions.md .ai/current-plan.md .ai/state.md .ai/run-log.md .ai/handoff.md; do
    if [[ -e "$record" ]]; then records+=("$record"); fi
  done
  git add -- "${records[@]}"
  # Always the host's own commit (empty if the session committed everything, or after a crash
  # between this commit and its host record): an agent commit's subject never counts.
  git commit --allow-empty -m 'chore(ai): record review triage' >/dev/null
  ai_guard_verify
  # The host record of this round is what the pipeline's fix round limit counts.
  ai_helper fix-rounds record HEAD || ai_die 'Cannot record the fix round in the host state directory.'
  # A commit hook must not have slipped anything else into the counted commit.
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || \
    ai_die 'Triage stage: changes were left after the triage commit (commit hook?).'
  triage_scope 'Triage stage: the triage commit is out of scope (commit hook?): '
  finished=yes
  printf '%s\n' 'Triage complete.'
  exit 0
fi

if [[ -f .ai/prompts/runner.md ]]; then
  base_prompt=$(cat .ai/prompts/runner.md)
else
  base_prompt=$(cat .ai/prompts/resume.md .ai/prompts/implement.md)
fi

if [[ "$sessions_given" == yes ]]; then
  printf 'Session budget: %s (--sessions)\n' "$sessions"
else
  read -r budget_done budget_total < <(ai_helper tasks counts) || ai_die 'Cannot count tasks for the session budget.'
  sessions=$(( budget_total - budget_done + 2 ))
  (( sessions >= 16 )) || sessions=16
  printf 'Session budget: %s (default: %s unfinished tasks + 2, at least 16)\n' \
    "$sessions" "$(( budget_total - budget_done ))"
fi

# Records the runner bookkeeping of TASK's DONE or BLOCKED checkpoint in its own commit (never
# application files); an accepted DONE checkpoint must hold exactly the validated bytes.
# Usage: runner_checkpoint TASK STATUS.
runner_checkpoint() {
  ai_helper state implementing 'Continue queue; see task results for any blockers'
  git add -- .ai/state.md .ai/run-log.md .ai/handoff.md
  git commit -m "chore(ai): record $1 runner checkpoint" >/dev/null
  ai_helper run-manifest task-clear 2>/dev/null || true
  ai_guard_verify
  # A BLOCKED task is unvalidated by design; only an accepted DONE checkpoint is checked.
  if [[ "$2" == DONE ]]; then
    verify_checkpoint "$1"
    ai_notify "✅ Done: $(ai_helper tasks progress "$1")"
  fi
}

# TASK is DONE in the working queue: the full gate, then the tier-1 commit of whatever its session
# left uncommitted, then the runner checkpoint. Used after every session and for the preserved
# work of a usage-limit stop whose task was DONE before the limit. Usage: checkpoint_done TASK.
checkpoint_done() {
  local task=$1 new_files=''
  remaining=$(remaining_time)
  (( remaining > 0 )) || ai_die 'Run time limit reached before post-task validation.'
  ai_observe step checks "$task"
  gate_started=$SECONDS
  host_gate
  ai_guard_verify
  record_gate "$gate_code" "$gate_started"
  if (( gate_code != 0 )); then
    task_outcome validation_failed
    ai_helper tasks set "$task" IN_PROGRESS
    ai_helper state blocked "Validation failed after $task; inspect validation log"
    ai_die "Validation failed; $task returned to IN_PROGRESS."
  fi
  if counts=$(ai_helper tasks counts 2>/dev/null) && read -r counts_done counts_total <<< "$counts"; then
    ai_observe step build "$task · checkpointed · $counts_done/$counts_total"
  fi
  if [[ -n "$(dirty_beyond_records)" ]]; then
    # Tier-1 recovery: the session finished and the full gate just passed on exactly
    # this content (gate files verified unchanged), but it didn't commit. Commit it.
    # The session started from a clean tree, or an armed resume from its own preserved task
    # work, so everything new is its own output. Stage it all (git still skips ignored
    # files), but never a secret-looking file.
    git add --all -- .
    if ! new_files=$(ai_helper checkpoint-guard); then
      git reset -q
      ai_die "Claude left uncommitted work including secret-looking files; inspect it before continuing."
    fi
    git commit -q -m "chore(ai): checkpoint $task (validated; the session did not commit)"
    ai_guard_verify
    # A commit hook must not have slipped unvalidated content into that checkpoint.
    [[ -z "$(git status --porcelain --untracked-files=all)" ]] && ai_helper stamp verify >/dev/null && \
      ai_helper committed-matches-worktree || \
      ai_die "The checkpoint of $task differs from the validated content (commit hook?)."
    ai_notify "🔧 $task: Claude didn't commit its validated work; the runner committed it.${new_files:+ New files: $new_files}"
  fi
  task_outcome done
  ai_log "$task" 'completed' PASS 'Claude checkpointed; continuing queue'
  runner_checkpoint "$task" DONE
}

# Gate-only block retry (FL-32): TASK was just checkpointed BLOCKED. When the session's own gate
# run left no failing check (validation.json changed during the session and reads running, pass
# or changed) and the host's full gate passes on this tree, set TASK back to IN_PROGRESS for one
# more session. Deterministic host evidence only, once per task per run: the manifest claim is
# spent before the gate runs, so a failing gate spends it too. A forged stamp buys at most one
# gate run and one session, and nothing is accepted without a later DONE checkpoint. Sets
# retry_note=TASK when it set the task back; otherwise TASK stays BLOCKED and the run goes on.
# Call it as a plain command (never in a || list) so errexit still guards its commits.
# Usage: gate_only_retry TASK.
gate_only_retry() {
  local task=$1 word='' digest=''
  read -r word digest < <(ai_helper stamp outcome 2>/dev/null) || return 0
  [[ -n "$digest" && "$digest" != - && "$digest" != "$stamp_before" ]] || return 0
  case "$word" in running|pass|changed) ;; *) return 0 ;; esac
  ai_helper run-manifest gate-unblock "$task" 2>/dev/null || return 0
  remaining=$(remaining_time)
  (( remaining > 0 )) || return 0
  ai_observe step checks "$task"
  gate_started=$SECONDS
  host_gate
  ai_guard_verify
  record_gate "$gate_code" "$gate_started"
  if (( gate_code != 0 )); then
    printf '%s\n' "Gate-only block retry of $task: the full gate failed; it stays BLOCKED."
    return 0
  fi
  ai_helper tasks set "$task" IN_PROGRESS
  ai_log "$task" 'gate-only block; host gate passed; retrying once' PASS 'See task result'
  git add -- .ai/tasks.md .ai/state.md .ai/run-log.md .ai/handoff.md
  git commit -m "chore(ai): retry $task after a gate-only block" >/dev/null
  ai_guard_verify
  ai_notify "🔧 $task: blocked without a failing check and the full gate passed; running it once more."
  retry_note=$task
}

# Preserved task work of a usage-limit stop (the relaunch armed it; admitted above). Every check
# here runs while the manifest is still armed, so each stop is terminal for recovery; only the
# act (the armed checkpoint or the bound task's session) follows the disarm.
bound='' route=''
if [[ "$AI_ARMED" == yes ]]; then
  bound=$(ai_helper run-manifest limit-task 2>/dev/null) || \
    ai_die 'Cannot read the task of the preserved work in the run manifest.'
  newly=$(ai_helper tasks newly-done HEAD 2>&1) || ai_die "Cannot compare the task queue with HEAD: ${newly#Error: }"
  [[ -z "$newly" || "$newly" == "$bound" ]] || \
    ai_die 'Preserved work marks another task DONE; inspect it before continuing.'
fi

# Missing/stale dependencies (fresh worktree, changed lockfile) are installed by the host,
# once, before a task runs (or the preserved work's checkpoint validates). Dependencies a task
# changes mid-run wait for the next start.
if [[ "$(ai_helper tasks next)" != none || -n "$bound" ]]; then
  deps_limit=${AI_DEPS_TIMEOUT:-1200}
  [[ "$deps_limit" =~ ^[1-9][0-9]{0,6}$ ]] || ai_die "Dependency setup: invalid AI_DEPS_TIMEOUT: $deps_limit"
  remaining=$(remaining_time)
  (( deps_limit <= remaining )) || deps_limit=$remaining
  ai_deps "$AI_APPROVED_GATE" "$deps_limit" || ai_die "$AI_DEPS_ERROR"
fi

if [[ -n "$bound" ]]; then
  # The route, by the bound task's status in the working queue (DONE in HEAD or only here alike).
  bound_status=$(ai_helper tasks status "$bound" 2>/dev/null) || \
    ai_die "Preserved work belongs to $bound, which is not in the task queue; inspect the queue."
  case "$bound_status" in
    DONE) route=checkpoint ;;
    IN_PROGRESS|TODO)
      next_task=$(ai_helper tasks next)
      [[ "$next_task" == "$bound" ]] || \
        ai_die "Preserved work belongs to $bound, but the next task is $next_task; inspect the queue."
      route=session ;;
    BLOCKED) ai_die 'Blocked task was not checkpointed; inspect and commit before resuming.' ;;
    *) ai_die "Preserved work belongs to $bound, whose status $bound_status is unknown; inspect the queue." ;;
  esac
  # The loop head's checks, once more while armed.
  ai_guard_verify
  ai_branch
  ai_helper tasks check
  ai_helper run-manifest limit-disarm || ai_die 'Cannot consume the preserved work in the run manifest.'
  AI_ARMED=consumed
  printf 'Resuming preserved work of the usage-limit stop (%s).\n' "$bound"
fi

# The run's task record (host manifest) names the task a usage-limit stop's preserved work
# belongs to. A stale one from an interrupted run must never bind a later stop.
ai_helper run-manifest task-clear 2>/dev/null || true

if [[ "$route" == checkpoint ]]; then
  # The armed checkpoint: no session; the outcome log gets a `done` line without an attempt.
  active_task=$bound
  task_model=$(ai_helper tasks model "$bound")
  task_started=$SECONDS
  checkpoint_done "$bound"
fi

retry_note='' stamp_before=-
for (( iteration=1; iteration<=sessions+1; iteration++ )); do
  ai_guard_verify
  ai_branch
  ai_helper tasks check
  active_task=$(ai_helper tasks next)
  counts_done='' counts_total=''
  if counts=$(ai_helper tasks counts 2>/dev/null); then read -r counts_done counts_total <<< "$counts" || true; fi
  if [[ "$active_task" == none ]]; then
    if ! ai_helper tasks complete; then
      ai_helper state blocked 'No runnable tasks; resolve blockers/dependencies'
      ai_die 'Unfinished tasks exist but none can run. See .ai/tasks.md.'
    fi
    remaining=$(remaining_time)
    (( remaining > 0 )) || ai_die 'Run time limit reached before final validation.'
    ai_observe step checks final
    gate_started=$SECONDS
    host_gate
    ai_guard_verify
    record_gate "$gate_code" "$gate_started"
    if (( gate_code != 0 )); then
      ai_helper state blocked 'Final validation failed; inspect validation log'
      ai_die 'Final validation failed; readiness is not established.'
    fi
    ai_observe detail checks 'final · passed'
    ai_helper state ready_for_review 'Run independent Codex review, then human testing'
    ai_log none 'queue complete; ready for independent review' PASS 'Human acceptance remains'
    git add -- .ai/state.md .ai/run-log.md
    git commit -m 'chore(ai): record review handoff' >/dev/null
    ai_guard_verify
    # The stamp excludes metadata so this bookkeeping does not invalidate it.
    verify_checkpoint 'final handoff'
    finished=yes
    [[ -n "${AI_PIPELINE:-}" ]] || ai_notify 'All tasks done and validated; ready for independent review.'
    printf '%s\n' 'Tasks complete and validation passed. Review with Codex; test and merge manually.'
    exit 0
  fi
  (( iteration <= sessions )) || ai_die 'Session limit reached; inspect ai-status and rerun --approved to continue.'
  ai_helper state implementing "Resume/implement $active_task"
  task_model=$(ai_helper tasks model "$active_task")
  if [[ -n "$counts_total" ]]; then
    ai_observe step build "$active_task · ${task_model:-${model:-default}} · $(( counts_done + 1 ))/$counts_total"
  fi
  prompt=$base_prompt
  prompt+=$'\n\nRUNNER CONTRACT: Work on exactly one task in this invocation: '
  prompt+="$active_task"
  prompt+=$'. Reconcile interrupted work first. Complete and checkpoint it, or mark it BLOCKED with evidence. A gate run that outlives a tool call is not a blocker: the full gate the runner runs after the session decides. Then return; the runner continues the queue in a fresh session. Never change the branch or runner/permissions/validation policy to bypass restrictions. Follow "How to work here" above for tools and shell rules; run git add -- <paths> and git commit as plain commands.'
  if [[ -n "$retry_note" && "$retry_note" == "$active_task" ]]; then
    prompt+=" The previous session marked $active_task BLOCKED without a failing check; the runner's full gate then passed on this tree. If the block was only about the gate result, verify the acceptance criteria and mark it DONE; otherwise block it again with the reason."
  fi
  retry_note=''
  prompt+=$(knowledge_prompt)
  printf 'Iteration %s/%s\n' "$iteration" "$sessions"
  # Best effort: a standalone run has no manifest (and no relaunch); in a pipeline a lost record
  # makes a later limit-arm fail closed. Kept through a limit stop (on_exit leaves it).
  ai_helper run-manifest task-set "$active_task" 2>/dev/null || \
    printf '%s\n' 'Note: could not record the task in the run manifest.' >&2
  # What the session's own gate runs change in validation.json is the gate-only retry's evidence.
  stamp_before=-
  read -r _ stamp_before < <(ai_helper stamp outcome 2>/dev/null) || stamp_before=-
  [[ -n "$stamp_before" ]] || stamp_before=-
  track_attempt=yes
  claude_session "$prompt" "${task_model:-$model}" "$all_tools" "${allowed[@]}"
  track_attempt=no
  # claude_session already checked the branch and restored recorded executable bits.
  ai_helper tasks check
  task_status=$(ai_helper tasks status "$active_task")
  case "$task_status" in
    DONE) checkpoint_done "$active_task" ;;
    BLOCKED)
      [[ -z "$(dirty_beyond_records)" ]] || \
        ai_die 'Blocked task was not checkpointed; inspect and commit before resuming.'
      task_outcome blocked
      ai_log "$active_task" 'blocked; try next independent task' 'not complete' 'See task result'
      runner_checkpoint "$active_task" BLOCKED
      retry_note=''
      gate_only_retry "$active_task"
      [[ "$retry_note" == "$active_task" ]] || \
        ai_notify "⚠ Blocked: $(ai_helper tasks progress "$active_task"); trying other independent tasks" ;;
    *) task_outcome no_checkpoint
       ai_die "No completed/blocked checkpoint for $active_task; refusing an automatic retry loop." ;;
  esac
done
